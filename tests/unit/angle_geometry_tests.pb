; -----------------------------------------------------------------------------
; DoomPB - M3-02 BAM angle, exact trig tables and geometry unit tests
; Copyright (C) 2026 DoomPB contributors
; SPDX-License-Identifier: GPL-2.0-only
;
; Standalone suite: this entry point includes src/Core/Fixed.pbi,
; src/Core/Angle.pbi, src/Core/TrigTables.pbi, src/Renderer/Geometry.pbi, the
; types-only src/Map/MapTypes.pbi record vocabulary for AG47 and a generated
; numeric fixture. No WAD, map loader, palette, graphics, window, renderer backend
; or commercial asset is needed (I01 separately proves the four-module core).
;
; AG01-AG08: BAM representation/indexing and standalone inclusion (MapTypes
;             is types-only for AG47; no WAD/map-loader/graphics code is present).
; AG09-AG16: exact upsteam table shapes, samples, full little-endian FNV-1a64
;             hashes and cosine sine-offset alias.
; AG17-AG24: SlopeDiv original unsigned shift-before-division formula.
; AG25-AG32: R_PointToAngle octant/boundary/delta safety policy.
; AG33-AG40: R_PointToDist exact FixedDiv/sine outputs and degenerate cases.
; AG41-AG48: node/seg point-side fast paths, XOR shortcut, ties and stability.
;
; Expected Angle/Distance/Side outputs come from tests/fixtures/
; m3_geometry_golden.pbi, generated by scripts/gen_geometry_golden.py with a
; separate Python integer oracle reading the pinned tables.c. Slope expectations
; are independently cross-checked by a test-only division oracle. The full table
; hashes are recomputed from the PureBasic runtime tables, not from fixture text.
;
; Exit code: 0 when every assertion passed, otherwise the number of failures.
; -----------------------------------------------------------------------------

EnableExplicit

XIncludeFile "../../src/Core/Fixed.pbi"
XIncludeFile "../../src/Core/Angle.pbi"
XIncludeFile "../../src/Core/TrigTables.pbi"
XIncludeFile "../../src/Renderer/Geometry.pbi"
XIncludeFile "../../src/Map/MapTypes.pbi"
XIncludeFile "../fixtures/m3_geometry_golden.pbi"

#TEST_FNV_Offset = -3750763034362895579
#TEST_FNV_Prime = 1099511628211
#TEST_TangentHash = "6E300CFD277525E1"
#TEST_SineHash = "ADD266F0CB7B06B6"
#TEST_TanToAngleHash = "56213612F87A0F4A"

#TEST_LCG_Seed = $12345678
#TEST_LCG_Multiplier = 1103515245
#TEST_LCG_Addend = 12345

; Compile-time proof that this harness has none of the runtime dependencies that
; M3-02 must not require. The constants are evaluated from the include set only.
CompilerIf Defined(WADOpen, #PB_Procedure) <> 0
  #TEST_WadApiPresent = 1
CompilerElse
  #TEST_WadApiPresent = 0
CompilerEndIf

CompilerIf Defined(VideoShowFramebuffer, #PB_Procedure) <> 0
  #TEST_VideoApiPresent = 1
CompilerElse
  #TEST_VideoApiPresent = 0
CompilerEndIf

CompilerIf Defined(MapLevelLoad, #PB_Procedure) <> 0
  #TEST_MapApiPresent = 1
CompilerElse
  #TEST_MapApiPresent = 0
CompilerEndIf

; AG47 uses the native MapTypes decoder record structures (raw signed 16-bit map
; unit fields) with synthetic values. The loader/decoders are not included, so
; no WAD or level buffer is borrowed; conversion uses FixedFromIntChecked.

Global gCaseCount.i = 0
Global gAssertionCount.i = 0
Global gFailureCount.i = 0
Global gTestLcgState.q = #TEST_LCG_Seed

; ---------------------------------------------------------------------------
; Harness
; ---------------------------------------------------------------------------

Procedure BeginCase(Id.s, Title.s)
  gCaseCount + 1
  PrintN("")
  PrintN("[" + Id + "] " + Title)
EndProcedure

Procedure Check(Ok.i, Description.s)
  gAssertionCount + 1
  If Ok
    PrintN("  PASS: " + Description)
  Else
    PrintN("  FAIL: " + Description)
    gFailureCount + 1
  EndIf
EndProcedure

Procedure.q FnvAddByte(Hash.q, Value.i)
  Hash = Hash ! (Value & $FF)
  Hash = Hash * #TEST_FNV_Prime
  ProcedureReturn Hash
EndProcedure

Procedure.q FnvAddLong(Hash.q, Value.l)
  Hash = FnvAddByte(Hash, Value & $FF)
  Hash = FnvAddByte(Hash, (Value >> 8) & $FF)
  Hash = FnvAddByte(Hash, (Value >> 16) & $FF)
  Hash = FnvAddByte(Hash, (Value >> 24) & $FF)
  ProcedureReturn Hash
EndProcedure

; Test-only independent implementation of the original SlopeDiv expression.
; It uses separate low-32 masking and division, not the production procedure.
Procedure.l TestSlopeDivOracle(Num.q, Den.q)
  Protected numerator.q
  Protected denWord.q
  Protected answer.q

  If Den < 512
    ProcedureReturn #BAM_SLOPERANGE
  EndIf

  numerator = (Num & $FFFFFFFF) << 3 & $FFFFFFFF
  denWord = (Den & $FFFFFFFF) >> 8
  answer = numerator / denWord
  If answer > #BAM_SLOPERANGE
    ProcedureReturn #BAM_SLOPERANGE
  EndIf
  ProcedureReturn answer
EndProcedure

Procedure.q TestLcgNext()
  gTestLcgState = gTestLcgState * #TEST_LCG_Multiplier + #TEST_LCG_Addend
  gTestLcgState = gTestLcgState & $FFFFFFFF
  ProcedureReturn gTestLcgState
EndProcedure

; ---------------------------------------------------------------------------
; Generated golden fixture access helpers
; ---------------------------------------------------------------------------

Procedure.i CheckSlopeVector(Index.i, Description.s)
  Protected num.q = PeekQ(*gGeoGoldSlopeNum + Index * 8)
  Protected den.q = PeekQ(*gGeoGoldSlopeDen + Index * 8)
  Protected expected.l = PeekL(*gGeoGoldSlopeExpected + Index * 4)
  Protected actual.l = -7777777
  Protected ok.i = DoomSlopeDivChecked(num, den, @actual)

  Check(Bool(ok <> 0 And actual = expected),
        Description + " vector " + Str(Index) + " (" + Str(num) + "/" + Str(den) + ") = " + Str(expected))
  ProcedureReturn ok
EndProcedure

Procedure.i CheckAngleVector(Index.i, Description.s)
  Protected viewX.l = PeekL(*gGeoGoldAngleViewX + Index * 4)
  Protected viewY.l = PeekL(*gGeoGoldAngleViewY + Index * 4)
  Protected pointX.l = PeekL(*gGeoGoldAngleX + Index * 4)
  Protected pointY.l = PeekL(*gGeoGoldAngleY + Index * 4)
  Protected expected.q = PeekQ(*gGeoGoldAngleExpected + Index * 8)
  Protected angleOut.BamAngleValue
  Protected ok.i

  angleOut\Raw = 999999
  ok = GeometryPointToAngleChecked(viewX, viewY, pointX, pointY, @angleOut)
  Check(Bool(ok <> 0 And angleOut\Raw = expected),
        Description + " vector " + Str(Index) + " -> raw " + Hex(expected))
  ProcedureReturn ok
EndProcedure

Procedure.i CheckDistanceVector(Index.i, Description.s)
  Protected viewX.l = PeekL(*gGeoGoldDistanceViewX + Index * 4)
  Protected viewY.l = PeekL(*gGeoGoldDistanceViewY + Index * 4)
  Protected pointX.l = PeekL(*gGeoGoldDistanceX + Index * 4)
  Protected pointY.l = PeekL(*gGeoGoldDistanceY + Index * 4)
  Protected expected.l = PeekL(*gGeoGoldDistanceExpected + Index * 4)
  Protected fixtureOk.i = PeekL(*gGeoGoldDistanceOk + Index * 4)
  Protected actual.l = -7777777
  Protected ok.i = GeometryPointToDistChecked(viewX, viewY, pointX, pointY, @actual)

  Check(Bool(ok <> 0 And fixtureOk <> 0 And actual = expected),
        Description + " vector " + Str(Index) + " -> distance " + Str(expected))
  ProcedureReturn ok
EndProcedure

; Node or seg side wrapper for the same fixture line direction. The seg variant
; derives v2 as origin plus the fixture direction, so both original function
; shapes are exercised over identical geometry.
Procedure.i CheckSideVector(Index.i, UseSeg.i, Description.s)
  Protected pointX.l = PeekL(*gGeoGoldSideX + Index * 4)
  Protected pointY.l = PeekL(*gGeoGoldSideY + Index * 4)
  Protected originX.l = PeekL(*gGeoGoldSideOriginX + Index * 4)
  Protected originY.l = PeekL(*gGeoGoldSideOriginY + Index * 4)
  Protected lineDX.l = PeekL(*gGeoGoldSideLineDX + Index * 4)
  Protected lineDY.l = PeekL(*gGeoGoldSideLineDY + Index * 4)
  Protected expected.l = PeekL(*gGeoGoldSideExpected + Index * 4)
  Protected v2X.l
  Protected v2Y.l
  Protected side.l = -123
  Protected ok.i

  If UseSeg
    v2X = originX + lineDX
    v2Y = originY + lineDY
    ok = GeometryPointOnSegSideChecked(pointX, pointY, originX, originY, v2X, v2Y, @side)
  Else
    ok = GeometryPointOnNodeSideChecked(pointX, pointY, originX, originY, lineDX, lineDY, @side)
  EndIf

  Check(Bool(ok <> 0 And side = expected),
        Description + " vector " + Str(Index) + " -> side " + Str(expected))
  ProcedureReturn ok
EndProcedure

; ---------------------------------------------------------------------------
; AG01-AG08 - BAM representation and indexing
; ---------------------------------------------------------------------------

Procedure TestAG01()
  BeginCase("AG01", "BAM cardinal constants are unsigned raw bit patterns")
  Check(Bool(#BAM_ANG45 = $20000000), "ANG45 raw value is 536870912 / 0x20000000")
  Check(Bool(#BAM_ANG90 = $40000000), "ANG90 raw value is 1073741824 / 0x40000000")
  Check(Bool(#BAM_ANG180 = $80000000), "ANG180 raw value is 2147483648 / 0x80000000")
  Check(Bool(#BAM_ANG270 = $C0000000), "ANG270 raw value is 3221225472 / 0xC0000000")
  Check(Bool(#BAM_RAW_MAX = $FFFFFFFF), "raw ring maximum is 4294967295 / 0xFFFFFFFF")
  Check(Bool(Hex(#BAM_ANG45) = "20000000"), "ANG45 hex pattern")
  Check(Bool(Hex(#BAM_ANG90) = "40000000"), "ANG90 hex pattern")
  Check(Bool(Hex(#BAM_ANG180) = "80000000"), "ANG180 hex pattern")
  Check(Bool(Hex(#BAM_ANG270) = "C0000000"), "ANG270 hex pattern")
EndProcedure

Procedure TestAG02()
  BeginCase("AG02", "BAM add/subtract/negation wrap modulo 2^32")
  Check(Bool(BamAdd($FFFFFFFF, 1) = 0), "0xFFFFFFFF + 1 wraps to 0")
  Check(Bool(BamSubtract(0, 1) = $FFFFFFFF), "0 - 1 wraps to 0xFFFFFFFF")
  Check(Bool(BamAdd(#BAM_ANG270, #BAM_ANG90) = 0), "ANG270 + ANG90 wraps to 0")
  Check(Bool(BamAdd(#BAM_ANG180, #BAM_ANG180) = 0), "ANG180 + ANG180 wraps to 0")
  Check(Bool(BamSubtract(#BAM_ANG90, 1) = $3FFFFFFF), "ANG90 - 1 raw boundary")
  Check(Bool(BamNegate(#BAM_ANG45) = $E0000000), "-ANG45 unsigned negation")
  Check(Bool(BamAdd($100000000, #BAM_ANG90) = #BAM_ANG90), "above-ring input is masked in add")
EndProcedure

Procedure TestAG03()
  BeginCase("AG03", "fine index from cardinal angles and near maximum")
  Check(Bool(BamFineIndex(0) = 0), "raw 0 -> fine index 0")
  Check(Bool(BamFineIndex(#BAM_ANG90) = 2048), "ANG90 -> fine index 2048")
  Check(Bool(BamFineIndex(#BAM_ANG180) = 4096), "ANG180 -> fine index 4096")
  Check(Bool(BamFineIndex(#BAM_ANG270) = 6144), "ANG270 -> fine index 6144")
  Check(Bool(BamFineIndex($FFFFFFFF) = 8191), "near-max raw -> fine index 8191")
  Check(Bool(BamFineIndex($100000000) = 0), "full turn wraps to fine index 0")
EndProcedure

Procedure TestAG04()
  BeginCase("AG04", "signed .l bit patterns preserve unsigned table indexing")
  Protected signed180.l = -2147483648
  Protected signed270.l = -1073741824

  Check(Bool(BamFineIndex(signed180) = 4096), "signed .l 0x80000000 indexes as ANG180")
  Check(Bool(BamFineIndex(signed270) = 6144), "signed .l 0xC0000000 indexes as ANG270")
  Check(Bool(BamWrap32(signed180) = 2147483648), "negative .l bit transport restores unsigned ANG180")
  Check(Bool(BamRawInUnsignedDomain(signed180) = #False), "the signed .l carrier itself is not a canonical unsigned .q value")
EndProcedure

Procedure TestAG05()
  BeginCase("AG05", "ANGLETOFINESHIFT, mask and 2^32/8192 identity")
  Check(Bool(#BAM_ANGLETOFINESHIFT = 19), "ANGLETOFINESHIFT is 19")
  Check(Bool(#BAM_FINEMASK = 8191), "FINEMASK is 8191")
  Check(Bool((1 << #BAM_ANGLETOFINESHIFT) = 524288), "2^19 = 524288 = 2^32/FINEANGLES")
  Check(Bool((BamWrap32($FFFFFFFF) >> #BAM_ANGLETOFINESHIFT) & #BAM_FINEMASK = 8191), "raw shift then mask yields 8191")
  Check(Bool(BamFineIndex($40000000 + #BAM_FINEANGLES * 1) = 2048), "one full fine ring added to ANG90 keeps index 2048")
EndProcedure

Procedure TestAG06()
  BeginCase("AG06", "out-of-ring raw angle inputs use documented low-32 normalization")
  Check(Bool(BamRawInUnsignedDomain($FFFFFFFF) = #True), "canonical maximum is inside the unsigned domain")
  Check(Bool(BamRawInUnsignedDomain($100000000) = #False), "2^32 is outside the canonical Quad domain")
  Check(Bool(BamRawInUnsignedDomain(-1) = #False), "negative Quad is outside the canonical Quad domain")
  Check(Bool(BamFineIndex(-1) = 8191), "negative input masks to 0xFFFFFFFF index 8191")
  Check(Bool(BamFineIndex($100000001) = 0), "2^32+1 masks to raw 1 index 0")
  Check(Bool(BamFineIndex($1FFFFFFFF) = 8191), "2^33-1 masks to 0xFFFFFFFF index 8191")
  Check(Bool(BamFineIndex(-140737488355328) = 0), "far negative Quad masks to raw 0")
EndProcedure

Procedure TestAG07()
  BeginCase("AG07", "repeated angle normalization/indexing is deterministic")
  Protected firstNormalized.q = BamWrap32(#BAM_ANG180 + 1)
  Protected secondNormalized.q = BamWrap32(#BAM_ANG180 + 1)
  Protected firstIndex.q = BamFineIndex(-2147483648)
  Protected secondIndex.q = BamFineIndex(-2147483648)
  Protected i.i
  Protected mismatch.i = 0
  Protected repeatedIndex.q

  Check(Bool(firstNormalized = secondNormalized), "wrap repeats identically")
  Check(Bool(firstIndex = secondIndex), "signed-bit index repeats identically")
  For i = 0 To 15
    repeatedIndex = BamFineIndex(#BAM_ANG270 + i)
    If repeatedIndex <> BamFineIndex(#BAM_ANG270 + i)
      mismatch + 1
    EndIf
  Next
  Check(Bool(mismatch = 0), "16 repeated three-quarter-ring indexes are identical")
EndProcedure

Procedure TestAG08()
  BeginCase("AG08", "modules compile/run with no WAD, map loader, video or renderer dependency")
  Check(Bool(#TEST_WadApiPresent = 0), "no WAD API symbol is included")
  Check(Bool(#TEST_VideoApiPresent = 0), "no video/presentation API symbol is included")
  Check(Bool(#TEST_MapApiPresent = 0), "no map loader API symbol is included")
  Protected sineFirst.l = 0
  Protected sineSecond.l = 0
  Protected stable.i

  stable = TrigSineChecked(0, @sineFirst)
  TrigSineChecked(0, @sineSecond)
  Check(Bool(stable <> 0 And sineFirst = 25 And sineSecond = 25), "immutable sine entry is stable across calls")
EndProcedure

; ---------------------------------------------------------------------------
; AG09-AG16 - exact tables and cosine alias
; ---------------------------------------------------------------------------

Procedure TestAG09()
  BeginCase("AG09", "finetangent length 4096 and exact first/last/interior samples")
  Protected value.l = 0

  Check(Bool(#TRIG_FINETANGENT_COUNT = 4096), "effective finetangent length is 4096")
  Check(Bool(TrigTangentChecked(0, @value) <> 0 And value = -170910304), "finetangent[0] = -170910304")
  Check(Bool(TrigTangentChecked(4095, @value) <> 0 And value = 170910304), "finetangent[4095] = 170910304")
  Check(Bool(TrigTangentChecked(1024, @value) <> 0 And value = -65485), "finetangent[1024] = -65485")
  Check(Bool(TrigTangentChecked(2048, @value) <> 0 And value = 25), "finetangent[2048] = 25")
  Check(Bool(TrigTangentChecked(3072, @value) <> 0 And value = 65586), "finetangent[3072] = 65586")
EndProcedure

Procedure TestAG10()
  BeginCase("AG10", "finesine length 10240 and exact selected samples")
  Protected value.l = 0

  Check(Bool(#TRIG_SINE_COUNT = 10240), "effective finesine length is 10240")
  Check(Bool(TrigSineChecked(0, @value) <> 0 And value = 25), "finesine[0] = 25")
  Check(Bool(TrigSineChecked(10239, @value) <> 0 And value = 65535), "finesine[10239] = 65535")
  Check(Bool(TrigSineChecked(2048, @value) <> 0 And value = 65535), "finesine[2048] = 65535")
  Check(Bool(TrigSineChecked(4096, @value) <> 0 And value = -25), "finesine[4096] = -25")
  Check(Bool(TrigSineChecked(6144, @value) <> 0 And value = -65535), "finesine[6144] = -65535")
  Check(Bool(TrigSineChecked(3072, @value) <> 0 And value = 46323), "finesine[3072] = 46323")
EndProcedure

Procedure TestAG11()
  BeginCase("AG11", "tantoangle length 2049 including exact endpoint index 2048")
  Protected value.l = 0

  Check(Bool(#TRIG_TANTOANGLE_COUNT = 2049), "effective tantoangle length is 2049")
  Check(Bool(TrigTanToAngleChecked(0, @value) <> 0 And value = 0), "tantoangle[0] = 0")
  Check(Bool(TrigTanToAngleChecked(2048, @value) <> 0 And value = 536870912), "tantoangle[2048] = ANG45/536870912")
  Check(Bool(TrigTanToAngleChecked(1024, @value) <> 0 And value = 316933408), "tantoangle[1024] = 316933408")
  Check(Bool(TrigTanToAngleChecked(2047, @value) <> 0 And value = 536704000), "tantoangle[2047] = 536704000")
EndProcedure

Procedure TestAG12()
  BeginCase("AG12", "full 4096-entry tangent little-endian FNV-1a64 hash")
  Protected hash.q = #TEST_FNV_Offset
  Protected value.l = 0
  Protected i.i
  Protected entryCount.i = 0
  Protected accessOk.i = 1

  For i = 0 To #TRIG_FINETANGENT_COUNT - 1
    If TrigTangentChecked(i, @value) = #False
      accessOk = 0
      Break
    EndIf
    hash = FnvAddLong(hash, value)
    entryCount + 1
  Next
  Check(Bool(accessOk = 1 And entryCount = 4096), "every tangent entry passes validated access")
  Check(Bool(Hex(hash) = #TEST_TangentHash), "finetangent full hash = " + Hex(hash))
EndProcedure

Procedure TestAG13()
  BeginCase("AG13", "full 10240-entry sine little-endian FNV-1a64 hash")
  Protected hash.q = #TEST_FNV_Offset
  Protected value.l = 0
  Protected i.i
  Protected entryCount.i = 0
  Protected accessOk.i = 1

  For i = 0 To #TRIG_SINE_COUNT - 1
    If TrigSineChecked(i, @value) = #False
      accessOk = 0
      Break
    EndIf
    hash = FnvAddLong(hash, value)
    entryCount + 1
  Next
  Check(Bool(accessOk = 1 And entryCount = 10240), "every sine entry passes validated access")
  Check(Bool(Hex(hash) = #TEST_SineHash), "finesine full hash = " + Hex(hash))
EndProcedure

Procedure TestAG14()
  BeginCase("AG14", "full 2049-entry slope-to-angle little-endian FNV-1a64 hash")
  Protected hash.q = #TEST_FNV_Offset
  Protected value.l = 0
  Protected i.i
  Protected entryCount.i = 0
  Protected accessOk.i = 1

  For i = 0 To #TRIG_TANTOANGLE_COUNT - 1
    If TrigTanToAngleChecked(i, @value) = #False
      accessOk = 0
      Break
    EndIf
    hash = FnvAddLong(hash, value)
    entryCount + 1
  Next
  Check(Bool(accessOk = 1 And entryCount = 2049), "every tantoangle entry passes validated access")
  Check(Bool(Hex(hash) = #TEST_TanToAngleHash), "tantoangle full hash = " + Hex(hash))
EndProcedure

Procedure TestAG15()
  BeginCase("AG15", "cosine is the sine table offset by FINEANGLES/4")
  Protected value.l = 0
  Protected sineAtOffset.l = 0
  Protected cosineDirect.l = 0

  Check(Bool(#BAM_COSINE_OFFSET = 2048), "cosine alias offset is FINEANGLES/4 = 2048")
  Check(Bool(BamSin(0) = 25), "sin(0) table sample")
  Check(Bool(BamSin(#BAM_ANG90) = 65535), "sin(90) = 65535")
  Check(Bool(BamCos(0) = 65535), "cos(0) via sine[2048] = 65535")
  Check(Bool(BamCos(#BAM_ANG90) = -25), "cos(90) via sine[4096] = -25")
  Check(Bool(BamCos(#BAM_ANG180) = -65535), "cos(180) via sine[6144] = -65535")
  Check(Bool(BamCos(#BAM_ANG270) = 25), "cos(270) via sine[8192] = 25")
  Check(Bool(TrigCosineChecked(1024, @cosineDirect) <> 0 And cosineDirect = 46323), "cosine index 1024 = 46323")
  Check(Bool(TrigSineChecked(3072, @sineAtOffset) <> 0 And cosineDirect = sineAtOffset), "cosine index 1024 equals sine index 3072")
EndProcedure

Procedure TestAG16()
  BeginCase("AG16", "all out-of-range table accesses fail safely with valid boundaries")
  Protected sentinel.l = -987654321
  Protected value.l = 0

  value = sentinel
  Check(Bool(TrigTangentChecked(-1, @value) = #False And value = sentinel And TrigLastError() <> ""), "tangent negative index fails, output untouched")
  value = sentinel
  Check(Bool(TrigTangentChecked(4096, @value) = #False And value = sentinel), "tangent index 4096 fails")
  value = sentinel
  Check(Bool(TrigSineChecked(-1, @value) = #False And value = sentinel), "sine negative index fails")
  value = sentinel
  Check(Bool(TrigSineChecked(10240, @value) = #False And value = sentinel), "sine index 10240 fails")
  value = sentinel
  Check(Bool(TrigCosineChecked(-1, @value) = #False And value = sentinel), "cosine negative index fails")
  value = sentinel
  Check(Bool(TrigCosineChecked(8192, @value) = #False And value = sentinel), "cosine index 8192 fails")
  value = sentinel
  Check(Bool(TrigTanToAngleChecked(-1, @value) = #False And value = sentinel), "tantoangle negative index fails")
  value = sentinel
  Check(Bool(TrigTanToAngleChecked(2049, @value) = #False And value = sentinel), "tantoangle index 2049 fails")
  Check(Bool(TrigTangentChecked(4095, @value) <> 0), "tangent top boundary succeeds")
  Check(Bool(TrigSineChecked(10239, @value) <> 0), "sine top boundary succeeds")
  Check(Bool(TrigCosineChecked(8191, @value) <> 0), "cosine top boundary succeeds")
  Check(Bool(TrigTanToAngleChecked(2048, @value) <> 0), "tantoangle endpoint boundary succeeds")
EndProcedure

; ---------------------------------------------------------------------------
; AG17-AG24 - SlopeDiv and original division semantics
; ---------------------------------------------------------------------------

Procedure TestAG17()
  BeginCase("AG17", "denominator 0 and 511 produce original early result 2048")
  CheckSlopeVector(0, "den 0, num 0")
  CheckSlopeVector(1, "den 511, num 0")
  CheckSlopeVector(2, "den 0, num 1000")
  CheckSlopeVector(3, "den 511, num 1000")
EndProcedure

Procedure TestAG18()
  BeginCase("AG18", "denominator 512/513 and shift-before-division semantics")
  CheckSlopeVector(4, "den 12345 is not the (num*2048)/den formula")
  CheckSlopeVector(5, "den 512, num 0")
  CheckSlopeVector(6, "den 512, num 256")
  CheckSlopeVector(8, "den 513, num 256")
  CheckSlopeVector(10, "den 512, num 511 near cap")
  Check(Bool(TestSlopeDivOracle(1000, 12345) = 166), "independent oracle confirms 166 for 1000/12345")
  Check(Bool((1000 * 2048) / 12345 = 165), "non-equivalent formula would give 165, so truncating den>>8 matters")
EndProcedure

Procedure TestAG19()
  BeginCase("AG19", "numerator zero and equal small components")
  CheckSlopeVector(5, "numerator zero with den 512")
  CheckSlopeVector(15, "equal components 640/640 hit cap 2048")
  CheckSlopeVector(16, "equal components 1024/1024 hit cap 2048")
  CheckSlopeVector(22, "equal components 16384/16384 hit cap 2048")
EndProcedure

Procedure TestAG20()
  BeginCase("AG20", "quotient above SLOPERANGE saturates at 2048")
  CheckSlopeVector(12, "100000/512 quotient above cap")
  CheckSlopeVector(25, "0xFFFFFFFF/512 above cap")
  CheckSlopeVector(14, "2048/512 quotient above cap")
EndProcedure

Procedure TestAG21()
  BeginCase("AG21", "values immediately below and above the cap boundary")
  CheckSlopeVector(10, "511/512 = 2044 below cap")
  CheckSlopeVector(7, "512/512 = 2048 at cap")
  CheckSlopeVector(18, "65535/65536 = 2047 one below")
  CheckSlopeVector(19, "65536/65536 = 2048 at cap")
  Check(Bool(TestSlopeDivOracle(511, 512) = 2044), "independent oracle confirms 2044 boundary")
EndProcedure

Procedure TestAG22()
  BeginCase("AG22", "all fixture pairs compared with independent integer oracle")
  Protected i.i
  Protected visited.i = 0
  Protected mismatch.i = 0
  Protected num.q
  Protected den.q
  Protected expected.l
  Protected production.l = 0
  Protected oracle.l = 0

  For i = 0 To #GEOGOLD_SlopeCount - 1
    num = PeekQ(*gGeoGoldSlopeNum + i * 8)
    den = PeekQ(*gGeoGoldSlopeDen + i * 8)
    expected = PeekL(*gGeoGoldSlopeExpected + i * 4)
    production = 0
    oracle = TestSlopeDivOracle(num, den)
    DoomSlopeDivChecked(num, den, @production)
    If production <> expected Or oracle <> expected
      mismatch + 1
    EndIf
    visited + 1
  Next
  Check(Bool(visited = #GEOGOLD_SlopeCount), "every fixture SlopeDiv pair evaluated")
  Check(Bool(mismatch = 0), "production and independent oracle both match every fixture expectation")
EndProcedure

Procedure TestAG23()
  BeginCase("AG23", "deterministic spread of valid numerator/denominator pairs")
  Protected i.i
  Protected mismatch.i = 0
  Protected firstHash.q = #TEST_FNV_Offset
  Protected secondHash.q = #TEST_FNV_Offset
  Protected num.q
  Protected den.q
  Protected actual.l = 0
  Protected oracle.l = 0

  For i = 0 To 99
    num = TestLcgNext()
    den = TestLcgNext()
    actual = 0
    If DoomSlopeDivChecked(num, den, @actual) = #False
      mismatch + 1
    EndIf
    oracle = TestSlopeDivOracle(num, den)
    If actual <> oracle
      mismatch + 1
    EndIf
    firstHash = FnvAddLong(firstHash, actual)
  Next

  gTestLcgState = #TEST_LCG_Seed
  For i = 0 To 99
    num = TestLcgNext()
    den = TestLcgNext()
    actual = 0
    If DoomSlopeDivChecked(num, den, @actual) = #False
      mismatch + 1
    EndIf
    secondHash = FnvAddLong(secondHash, actual)
  Next

  Check(Bool(mismatch = 0), "100 documented-seed unsigned pairs match the test-only oracle")
  Check(Bool(firstHash = secondHash), "the 100-pair result checksum repeats from the same seed")
EndProcedure

Procedure TestAG24()
  BeginCase("AG24", "invalid signed/oversized caller inputs and documented domain")
  Protected value.l = 123456789
  Protected validMax.l = 0

  Check(Bool(DoomSlopeDivChecked(-1, 512, @value) = #False And value = 123456789 And TrigLastError() <> ""), "negative numerator rejected, output untouched")
  value = 123456789
  Check(Bool(DoomSlopeDivChecked(512, -1, @value) = #False And value = 123456789), "negative denominator rejected")
  value = 123456789
  Check(Bool(DoomSlopeDivChecked($100000000, 512, @value) = #False And value = 123456789), "numerator above 2^32 rejected")
  value = 123456789
  Check(Bool(DoomSlopeDivChecked(512, $100000000, @value) = #False And value = 123456789), "denominator above 2^32 rejected")
  Check(Bool(DoomSlopeDivChecked(512, 512, 0) = #False), "null result pointer rejected")
  Check(Bool(DoomSlopeDivChecked($FFFFFFFF, $FFFFFFFF, @validMax) <> 0), "canonical maximum unsigned pair is accepted")
  CheckSlopeVector(24, "0xFFFFFFFF/0xFFFFFFFF = exact unsigned 256")
EndProcedure

; ---------------------------------------------------------------------------
; AG25-AG32 - R_PointToAngle equivalence
; ---------------------------------------------------------------------------

Procedure TestAG25()
  BeginCase("AG25", "coincident point returns BAM 0")
  CheckAngleVector(0, "coincident origin/target")
  Protected angleOut.BamAngleValue
  Protected ok.i

  angleOut\Raw = 7777
  ok = GeometryPointToAngleChecked(0, 0, 0, 0, @angleOut)
  Check(Bool(ok <> 0 And angleOut\Raw = 0), "success path takes the original (!x && !y) return 0")
EndProcedure

Procedure TestAG26()
  BeginCase("AG26", "positive X/Y cardinal directions use original C branch values")
  CheckAngleVector(1, "positive X axis")
  CheckAngleVector(2, "positive Y axis includes ANG90-1")
  CheckAngleVector(15, "near positive X axis")
  CheckAngleVector(16, "near positive Y axis")
EndProcedure

Procedure TestAG27()
  BeginCase("AG27", "negative X/Y cardinal directions and unsigned wrap")
  CheckAngleVector(3, "negative X axis returns ANG180-1")
  CheckAngleVector(4, "negative Y axis returns ANG270")
  CheckAngleVector(17, "near negative X axis")
  CheckAngleVector(18, "near negative Y axis")
EndProcedure

Procedure TestAG28()
  BeginCase("AG28", "four diagonals, octant edges and strict x>y ties")
  CheckAngleVector(5, "+/+ diagonal tie -> ANG45-1")
  CheckAngleVector(6, "+/- diagonal tie -> ANG270+ANG45")
  CheckAngleVector(7, "-/+ diagonal tie -> ANG90+ANG45")
  CheckAngleVector(8, "-/- diagonal tie -> ANG270-1-ANG45")
  Check(Bool(PeekQ(*gGeoGoldAngleExpected + 5 * 8) = #BAM_ANG45 - 1), "fixture diagonal keeps ANG45-1 rather than ANG45")
EndProcedure

Procedure TestAG29()
  BeginCase("AG29", "all eight octants with independent golden vectors")
  CheckAngleVector(19, "octant 0 branch (+x,+y,x>y)")
  CheckAngleVector(20, "octant branch with x<0,y>=0")
  CheckAngleVector(21, "octant branch with x>=0,y<0")
  CheckAngleVector(22, "octant branch with x<0,y<0")
  CheckAngleVector(23, "octant 8 branch (+x,-y)")
  CheckAngleVector(24, "octant 0 with nonzero view")
  CheckAngleVector(25, "octant 2 with nonzero view")
  CheckAngleVector(2, "octant 1 cardinal")
  CheckAngleVector(4, "octant 7 cardinal")
  CheckAngleVector(3, "octant 3 cardinal")
  CheckAngleVector(8, "octant 5 diagonal")
EndProcedure

Procedure TestAG30()
  BeginCase("AG30", "one-LSB perturbations and ANGxx-1 boundary behavior")
  CheckAngleVector(9, "+1 LSB X exactly at tie becomes ANG45")
  CheckAngleVector(10, "+1 LSB Y stays ANG45-1")
  CheckAngleVector(11, "Y one below tie uses interior tantoangle")
  CheckAngleVector(12, "X one below tie crosses strict x>y")
  CheckAngleVector(13, "negative both +1 LSB crosses octant boundary")
  CheckAngleVector(14, "negative both Y+1 stays ANG270-1")
  Check(Bool(PeekQ(*gGeoGoldAngleExpected + 10 * 8) = $1FFFFFFF), "near-tie Y example is exactly ANG45-1")
EndProcedure

Procedure TestAG31()
  BeginCase("AG31", "two-point wrapper matches explicit view-origin function")
  Protected viewX.l = PeekL(*gGeoGoldAngleViewX + 19 * 4)
  Protected viewY.l = PeekL(*gGeoGoldAngleViewY + 19 * 4)
  Protected pointX.l = PeekL(*gGeoGoldAngleX + 19 * 4)
  Protected pointY.l = PeekL(*gGeoGoldAngleY + 19 * 4)
  Protected expected.q = PeekQ(*gGeoGoldAngleExpected + 19 * 8)
  Protected explicitOut.BamAngleValue
  Protected wrapperOut.BamAngleValue
  Protected explicitOk.i
  Protected wrapperOk.i

  explicitOut\Raw = 999999
  wrapperOut\Raw = 999999
  explicitOk = GeometryPointToAngleChecked(viewX, viewY, pointX, pointY, @explicitOut)
  wrapperOk = GeometryPointToAngle2Checked(viewX, viewY, pointX, pointY, @wrapperOut)
  Check(Bool(explicitOk <> 0 And explicitOut\Raw = expected), "explicit-origin call matches fixture")
  Check(Bool(wrapperOk <> 0 And wrapperOut\Raw = expected), "four-coordinate wrapper matches fixture")
  Check(Bool(explicitOut\Raw = wrapperOut\Raw), "wrapper and explicit API produce identical BAM")
EndProcedure

Procedure TestAG32()
  BeginCase("AG32", "signed32 extreme and overflow policy with unchanged checked outputs")
  Protected angleOut.BamAngleValue
  Protected ok.i

  CheckAngleVector(26, "valid large near INT32_MAX X delta")
  CheckAngleVector(27, "valid large negative Y delta")
  CheckAngleVector(28, "valid large equal deltas")
  CheckAngleVector(29, "valid delta from INT32_MAX view")
  CheckAngleVector(30, "INT32_MIN delta uses documented magnitude policy")
  angleOut\Raw = 12345
  ok = GeometryPointToAngleChecked(-1, 0, 2147483647, 0, @angleOut)
  Check(Bool(ok = #False And angleOut\Raw = 12345 And GeometryLastError() <> ""), "delta above signed32 rejected with untouched output")
  angleOut\Raw = 67890
  ok = GeometryPointToAngleChecked(0, -1, 0, 2147483647, @angleOut)
  Check(Bool(ok = #False And angleOut\Raw = 67890), "delta below signed32 rejected with untouched output")
  Check(Bool(GeometryPointToAngleChecked(0, 0, 0, 0, 0) = #False), "null result pointer rejected")
EndProcedure

; ---------------------------------------------------------------------------
; AG33-AG40 - R_PointToDist exactness
; ---------------------------------------------------------------------------

Procedure TestAG33()
  BeginCase("AG33", "horizontal and vertical axis-aligned distances")
  CheckDistanceVector(1, "positive X axis")
  CheckDistanceVector(2, "negative X axis")
  CheckDistanceVector(3, "positive Y axis")
  CheckDistanceVector(4, "negative Y axis")
EndProcedure

Procedure TestAG34()
  BeginCase("AG34", "45-degree diagonals use exact fixed-point Doom cosine")
  CheckDistanceVector(5, "+/+ diagonal")
  CheckDistanceVector(6, "+/- diagonal")
  CheckDistanceVector(7, "-/+ diagonal")
  CheckDistanceVector(8, "-/- diagonal")
  Check(Bool(PeekL(*gGeoGoldDistanceExpected + 5 * 4) = 92717), "diagonal gives exact table-derived 92717, not float sqrt")
EndProcedure

Procedure TestAG35()
  BeginCase("AG35", "unequal positive dx/dy and swapped-axis symmetry")
  CheckDistanceVector(9, "dx > dy")
  CheckDistanceVector(10, "dy > dx swaps to the same result")
  Check(Bool(PeekL(*gGeoGoldDistanceExpected + 9 * 4) = PeekL(*gGeoGoldDistanceExpected + 10 * 4)), "swap symmetry values match")
EndProcedure

Procedure TestAG36()
  BeginCase("AG36", "negative quadrants and nonzero viewpoint")
  CheckDistanceVector(15, "negative X and Y")
  CheckDistanceVector(16, "nonzero positive view origin")
  CheckDistanceVector(17, "nonzero negative view origin")
  Check(Bool(PeekL(*gGeoGoldDistanceExpected + 15 * 4) = 679962), "negative quadrant exact fixture distance")
EndProcedure

Procedure TestAG37()
  BeginCase("AG37", "sub-unit fractional fixed coordinates and deterministic division")
  CheckDistanceVector(11, "1/1 fractional diagonal")
  CheckDistanceVector(12, "3/1 fractional unequal")
  CheckDistanceVector(13, "1/3 fractional with swap")
  Protected first.l = 0
  Protected second.l = 0
  GeometryPointToDistChecked(0, 0, 1, 3, @first)
  GeometryPointToDistChecked(0, 0, 1, 3, @second)
  Check(Bool(first = second), "fractional division repeats identically")
EndProcedure

Procedure TestAG38()
  BeginCase("AG38", "identical point has explicit safe distance 0 policy")
  CheckDistanceVector(0, "coincident point")
  Protected distance.l = -7777777
  Protected ok.i

  ok = GeometryPointToDistChecked(0, 0, 0, 0, @distance)
  Check(Bool(ok <> 0 And distance = 0 And GeometryLastError() = ""), "coincident returns fixed 0 with no error and no 0/0 table index")
  distance = -7777777
  ok = GeometryPointToDistChecked(0, 0, 0, 0, @distance)
  Check(Bool(ok <> 0 And distance = 0), "policy repeats with unchanged Table indices")
EndProcedure

Procedure TestAG39()
  BeginCase("AG39", "deterministic repeated values and exact reference vectors")
  CheckDistanceVector(18, "large positive unequal exact saturation vector")
  CheckDistanceVector(19, "large swapped vector")
  CheckDistanceVector(20, "equal INT32_MAX deltas")
  Protected first.l = 0
  Protected second.l = 0
  Protected third.l = 0
  GeometryPointToDistChecked(0, 0, 65536, 65536, @first)
  GeometryPointToDistChecked(0, 0, 65536, 65536, @second)
  GeometryPointToDistChecked(0, 0, 65536, 65536, @third)
  Check(Bool(first = 92717 And first = second And second = third), "three repeated diagonal calls produce identical 92717")
EndProcedure

Procedure TestAG40()
  BeginCase("AG40", "signed32 overflow/magnitude policy and diagnostics")
  Protected distance.l = -7777777
  Protected ok.i

  CheckDistanceVector(21, "INT32_MIN magnitude uses documented widened FixedDiv formula")
  distance = -7777777
  ok = GeometryPointToDistChecked(-1, 0, 2147483647, 0, @distance)
  Check(Bool(ok = #False And distance = -7777777 And GeometryLastError() <> ""), "delta above signed32 fails without output change")
  distance = -7777777
  ok = GeometryPointToDistChecked(0, -1, 0, 2147483647, @distance)
  Check(Bool(ok = #False And distance = -7777777), "delta below signed32 fails without output change")
  Check(Bool(GeometryPointToDistChecked(0, 0, 0, 0, 0) = #False), "null result pointer rejected" )
EndProcedure

; ---------------------------------------------------------------------------
; AG41-AG48 - BSP side computations and stability
; ---------------------------------------------------------------------------

Procedure TestAG41()
  BeginCase("AG41", "vertical partitions, both orientations and boundary cases")
  Protected i.i
  For i = 0 To 5
    CheckSideVector(i, 0, "node vertical")
    CheckSideVector(i, 1, "seg vertical")
  Next
  Check(Bool(PeekL(*gGeoGoldSideExpected + 0 * 4) = 1), "vertical positive dy boundary returns back side")
  Check(Bool(PeekL(*gGeoGoldSideExpected + 3 * 4) = 0), "vertical negative dy boundary uses the direction sign")
EndProcedure

Procedure TestAG42()
  BeginCase("AG42", "horizontal partitions, both orientations and boundary cases")
  Protected i.i
  For i = 6 To 11
    CheckSideVector(i, 0, "node horizontal")
    CheckSideVector(i, 1, "seg horizontal")
  Next
EndProcedure

Procedure TestAG43()
  BeginCase("AG43", "general sloped line cross products and equality tie")
  CheckSideVector(12, 0, "node sloped exactly on line")
  CheckSideVector(13, 0, "node one LSB above line")
  CheckSideVector(14, 0, "node one LSB below X")
  CheckSideVector(15, 0, "node one LSB below Y")
  CheckSideVector(16, 0, "node near line")
  Check(Bool(PeekL(*gGeoGoldSideExpected + 12 * 4) = 1), "exact right<left equality tie returns back side 1")
  CheckSideVector(12, 1, "seg sloped equality tie")
EndProcedure

Procedure TestAG44()
  BeginCase("AG44", "XOR sign-bit short-circuit with negative coordinates")
  Protected i.i
  For i = 18 To 25
    CheckSideVector(i, 0, "node sign shortcut geometry")
  Next
  CheckSideVector(22, 1, "seg sign shortcut geometry")
  CheckSideVector(23, 1, "seg sign shortcut second orientation")
EndProcedure

Procedure TestAG45()
  BeginCase("AG45", "one-LSB near-boundary points and exact arithmetic shifts")
  CheckSideVector(13, 0, "one LSB above line")
  CheckSideVector(14, 0, "one LSB below X")
  CheckSideVector(15, 0, "one LSB below Y")
  CheckSideVector(19, 0, "negative lineDY is floored by the arithmetic >>16")
  CheckSideVector(16, 0, "steep line direction sample")
  Check(Bool(FixedToIntFloor(-65537) = -2), "the side products use arithmetic floor -65537 -> -2")
EndProcedure

Procedure TestAG46()
  BeginCase("AG46", "R_PointOnSegSide opposite endpoint direction and mirrored geometry")
  CheckSideVector(27, 1, "seg reversed/mirrored descending line boundary")
  CheckSideVector(28, 1, "seg reversed line one LSB above")
  CheckSideVector(29, 1, "seg reversed line one LSB below")
  CheckSideVector(18, 1, "seg mirrored sign orientation")
  CheckSideVector(19, 1, "seg opposite dy orientation")
EndProcedure

Procedure TestAG47()
  BeginCase("AG47", "synthetic map unit records converted without mutation or borrowing")
  Protected vertexA.MapVertex
  Protected vertexB.MapVertex
  Protected node.MapNode
  Protected fixedX.l = 0
  Protected fixedY.l = 0
  Protected fixedOriginX.l = 0
  Protected fixedOriginY.l = 0
  Protected fixedDX.l = 0
  Protected fixedDY.l = 0
  Protected angleOut.BamAngleValue
  Protected distance.l = 0
  Protected side.l = -123
  Protected rawSnapshot.i

  vertexA\X = 0
  vertexA\Y = 0
  vertexB\X = 1
  vertexB\Y = 1
  rawSnapshot = vertexB\X
  Check(Bool(FixedFromIntChecked(vertexA\X, @fixedX) <> 0 And fixedX = 0), "synthetic map vertex X 0 converts")
  Check(Bool(FixedFromIntChecked(vertexA\Y, @fixedOriginY) <> 0 And fixedOriginY = 0), "synthetic map vertex Y 0 converts")
  Check(Bool(FixedFromIntChecked(vertexB\X, @fixedY) <> 0 And fixedY = 65536), "synthetic map vertex X 1 converts to 65536")
  Check(Bool(FixedFromIntChecked(vertexB\Y, @fixedDX) <> 0 And fixedDX = 65536), "synthetic map vertex Y 1 converts to 65536")
  Check(Bool(GeometryPointToAngle2Checked(0, 0, 65536, 65536, @angleOut) <> 0 And angleOut\Raw = 536870911), "synthetic vertex pair angle equals fixture diagonal ANG45-1")
  Check(Bool(GeometryPointToDistChecked(0, 0, 65536, 65536, @distance) <> 0 And distance = 92717), "synthetic vertex pair distance equals fixture 92717")
  Check(Bool(vertexB\X = rawSnapshot), "synthetic raw record field is not mutated by conversion/geometry")

  node\X = 0
  node\Y = 0
  node\DX = 1
  node\DY = 1
  Check(Bool(FixedFromIntChecked(node\X, @fixedOriginX) <> 0 And fixedOriginX = 0), "node origin X converts")
  Check(Bool(FixedFromIntChecked(node\Y, @fixedOriginY) <> 0 And fixedOriginY = 0), "node origin Y converts")
  Check(Bool(FixedFromIntChecked(node\DX, @fixedDX) <> 0 And fixedDX = 65536), "node DX 1 converts")
  Check(Bool(FixedFromIntChecked(node\DY, @fixedDY) <> 0 And fixedDY = 65536), "node DY 1 converts")
  Check(Bool(GeometryPointOnNodeSideChecked(65536, 65536, 0, 0, 65536, 65536, @side) <> 0 And side = 1), "synthetic sloped node exact-tie side matches fixture back side")

  node\DX = 0
  node\DY = 1
  FixedFromIntChecked(node\DX, @fixedDX)
  FixedFromIntChecked(node\DY, @fixedDY)
  side = -123
  Check(Bool(GeometryPointOnNodeSideChecked(65536, 65536, 0, 0, 0, 65536, @side) <> 0 And side = 0), "synthetic vertical node dx=0 points right of origin -> front 0")
  node\DX = -1
  node\DY = 0
  FixedFromIntChecked(node\DX, @fixedDX)
  FixedFromIntChecked(node\DY, @fixedDY)
  side = -123
  Check(Bool(GeometryPointOnNodeSideChecked(0, 65536, 0, 0, -65536, 0, @side) <> 0 And side = 0), "synthetic horizontal node dy=0 below boundary -> dx<0 not taken above origin")
  Check(Bool(node\DX = -1 And node\DY = 0), "synthetic node partition fields stay unchanged")
EndProcedure

Procedure TestAG48()
  BeginCase("AG48", "repeated computations, error clearance, immutability and no state bleed")
  Protected side.l = -123
  Protected angleOut.BamAngleValue
  Protected distance.l = 0
  Protected value.l = -555
  Protected inputX.l = 65536
  Protected inputY.l = 65536
  Protected firstSide.l
  Protected secondSide.l
  Protected thirdSide.l
  Protected ok.i

  ok = GeometryPointOnNodeSideChecked(2147483647, 65536, -1, 0, 65536, 65536, @side)
  Check(Bool(ok = #False And GeometryLastError() <> ""), "invalid side delta sets a diagnostic")
  side = -123
  ok = CheckSideVector(0, 0, "valid after invalid")
  Check(Bool(ok <> 0 And GeometryLastError() = ""), "subsequent valid side operation clears GeometryLastError")

  value = -555
  ok = TrigSineChecked(10240, @value)
  Check(Bool(ok = #False And value = -555 And TrigLastError() <> ""), "invalid sine index sets TrigLastError")
  ok = TrigSineChecked(0, @value)
  Check(Bool(ok <> 0 And value = 25 And TrigLastError() = ""), "valid sine access clears TrigLastError")

  angleOut\Raw = 0
  GeometryPointToAngleChecked(0, 0, 65536, 65536, @angleOut)
  firstSide = angleOut\Raw
  angleOut\Raw = 0
  GeometryPointToAngleChecked(0, 0, 65536, 65536, @angleOut)
  secondSide = angleOut\Raw
  GeometryPointToAngleChecked(0, 0, 65536, 65536, @angleOut)
  thirdSide = angleOut\Raw
  Check(Bool(firstSide = 536870911 And firstSide = secondSide And secondSide = thirdSide), "three repeated angle calls are identical")

  firstSide = 0
  GeometryPointOnNodeSideChecked(inputX, inputY, 0, 0, 65536, 65536, @firstSide)
  GeometryPointOnNodeSideChecked(inputX, inputY, 0, 0, 65536, 65536, @secondSide)
  GeometryPointOnNodeSideChecked(inputX, inputY, 0, 0, 65536, 65536, @thirdSide)
  Check(Bool(firstSide = secondSide And secondSide = thirdSide), "three repeated side calls are identical")
  Check(Bool(inputX = 65536 And inputY = 65536), "geometry calls leave their fixed arguments unchanged")
  Check(Bool(GeometryLastError() = ""), "no previous error leaks into the final successful state")
EndProcedure

