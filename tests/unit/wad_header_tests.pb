; -----------------------------------------------------------------------------
; DoomPB - WAD header/directory unit tests (M1-01)
; Copyright (C) 2026 DoomPB contributors
; SPDX-License-Identifier: GPL-2.0-only
;
; All fixtures are generated by this program from synthetic data. No Doom
; resources are copied or required. Fixtures are written to a temporary
; directory next to the test executable (inside the ignored build/ tree) and
; removed before the program exits.
;
; Exit code: 0 when every assertion passed, otherwise the number of failures.
; -----------------------------------------------------------------------------

EnableExplicit

XIncludeFile "../../src/Core/Endian.pbi"
XIncludeFile "../../src/WAD/WAD.pbi"

CompilerIf #PB_Compiler_OS = #PB_OS_Windows
  #FixtureSeparator = "\"
CompilerElse
  #FixtureSeparator = "/"
CompilerEndIf

Global gFixtureDirectory.s = ""
Global gCaseCount.i = 0
Global gAssertionCount.i = 0
Global gFailureCount.i = 0

; ---------------------------------------------------------------------------
; Test harness
; ---------------------------------------------------------------------------

Procedure BeginCase(Id.s, Title.s)
  gCaseCount + 1
  PrintN("")
  PrintN("[" + Id + "] " + Title)
EndProcedure

Procedure Check(Ok.i, Description.s)
  gAssertionCount + 1
  If Ok
    PrintN("  PASS: " + Description)
  Else
    PrintN("  FAIL: " + Description)
    gFailureCount + 1
  EndIf
EndProcedure

; Asserts that a WAD is rejected, that the message is actionable and that no
; partial parser state survives the failure.
Procedure CheckRejected(Path.s, ExpectedFragment.s, Description.s)
  Protected opened.i = WADOpen(Path)

  Check(Bool(opened = #False), Description)
  Check(Bool(FindString(WADLastError(), ExpectedFragment) > 0), "error mentions '" + ExpectedFragment + "'")
  Check(Bool(WADIsOpen() = #False), "parser is not left open")
  Check(Bool(WADGetLumpCount() = 0), "no stale lump state after failure")
  WADClose()
EndProcedure

; ---------------------------------------------------------------------------
; Synthetic fixture writer (explicit little-endian, no structure casts)
; ---------------------------------------------------------------------------

Procedure WriteU32LE(file.i, Value.q)
  WriteByte(file, Value & $FF)
  WriteByte(file, (Value >> 8) & $FF)
  WriteByte(file, (Value >> 16) & $FF)
  WriteByte(file, (Value >> 24) & $FF)
EndProcedure

Procedure WriteWadHeader(file.i, Magic.s, LumpCount.q, DirectoryOffset.q)
  WriteString(file, Magic)
  WriteU32LE(file, LumpCount)
  WriteU32LE(file, DirectoryOffset)
EndProcedure

; Name is written as at most 8 bytes; shorter names are NUL padded.
Procedure WriteLumpEntry(file.i, Position.q, Size.q, Name.s)
  Protected i.i
  Protected value.i

  WriteU32LE(file, Position)
  WriteU32LE(file, Size)
  For i = 0 To 7
    If i < Len(Name)
      value = Asc(Mid(Name, i + 1, 1))
    Else
      value = 0
    EndIf
    WriteByte(file, value)
  Next
EndProcedure

Procedure WriteZeroBytes(file.i, Count.i)
  Protected i.i

  For i = 1 To Count
    WriteByte(file, 0)
  Next
EndProcedure

Procedure.s FixturePath(FileName.s)
  ProcedureReturn gFixtureDirectory + FileName
EndProcedure

; ---------------------------------------------------------------------------
; Fixture directory lifecycle
; ---------------------------------------------------------------------------

Procedure.i PrepareFixtureDirectory()
  Protected directorySize.i

  gFixtureDirectory = GetPathPart(ProgramFilename()) + "wad-test-tmp" + #FixtureSeparator
  directorySize = FileSize(gFixtureDirectory)
  If directorySize = -1
    ProcedureReturn CreateDirectory(gFixtureDirectory)
  EndIf
  If directorySize = -2
    ProcedureReturn #True
  EndIf
  ProcedureReturn #False
EndProcedure

Procedure CleanupFixtureDirectory()
  Protected directory.i
  Protected entryName.s

  directory = ExamineDirectory(#PB_Any, gFixtureDirectory, "*")
  If directory
    While NextDirectoryEntry(directory)
      If DirectoryEntryType(directory) = #PB_DirectoryEntry_File
        entryName = DirectoryEntryName(directory)
        DeleteFile(gFixtureDirectory + entryName)
      EndIf
    Wend
    FinishDirectory(directory)
  EndIf
  DeleteDirectory(gFixtureDirectory, "*")
EndProcedure

; ---------------------------------------------------------------------------
; Endian helpers (not part of the numbered WAD cases, but required by M1-01)
; ---------------------------------------------------------------------------

Procedure TestEndianHelpers()
  Protected memory.i

  BeginCase("E01", "Little-endian decoding helpers")
  memory = AllocateMemory(8)
  Check(Bool(memory <> 0), "test buffer allocated")
  If memory = 0
    ProcedureReturn
  EndIf

  PokeA(memory + 0, $34)
  PokeA(memory + 1, $12)
  PokeA(memory + 2, $78)
  PokeA(memory + 3, $56)

  Check(Bool(EndianReadU16LE(memory, 0) = $1234), "U16 decodes 34 12 as 0x1234")
  Check(Bool(EndianReadU32LE(memory, 0) = $56781234), "U32 decodes as 0x56781234")

  PokeA(memory + 0, $FF)
  PokeA(memory + 1, $FF)
  PokeA(memory + 2, $FF)
  PokeA(memory + 3, $FF)
  Check(Bool(EndianReadU32LE(memory, 0) = 4294967295), "U32 decodes as unsigned 4294967295")
  Check(Bool(EndianReadI32LE(memory, 0) = -1), "I32 decodes FF FF FF FF as -1")

  PokeA(memory + 0, $00)
  PokeA(memory + 1, $00)
  PokeA(memory + 2, $00)
  PokeA(memory + 3, $80)
  Check(Bool(EndianReadI32LE(memory, 0) = -2147483648), "I32 decodes 00 00 00 80 as -2147483648")

  PokeA(memory + 0, $00)
  PokeA(memory + 1, $00)
  PokeA(memory + 2, $00)
  PokeA(memory + 3, $00)
  Check(Bool(EndianReadI32LE(memory, 0) = 0), "I32 decodes zero correctly")

  FreeMemory(memory)
EndProcedure

; ---------------------------------------------------------------------------
; T01 - T16
; ---------------------------------------------------------------------------

Procedure Test01ValidIwad()
  Protected path.s = FixturePath("t01_iwad.wad")
  Protected file.i

  BeginCase("T01", "Small valid IWAD with one named data lump")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", 1, 16)
  WriteString(file, "DATA")
  WriteLumpEntry(file, 12, 4, "MYLUMP")
  CloseFile(file)

  Check(Bool(WADOpen(path) = #True), "WADOpen accepts the file")
  Check(Bool(WADIsOpen() = #True), "parser is open")
  Check(Bool(WADGetKind() = #WAD_KindIWAD), "kind is IWAD")
  Check(Bool(WADGetKindName() = "IWAD"), "kind name is IWAD")
  Check(Bool(WADGetFileSize() = 32), "file size is 32 bytes")
  Check(Bool(WADGetLumpCount() = 1), "lump count is 1")
  Check(Bool(WADGetDirectoryOffset() = 16), "directory offset is 16")
  Check(Bool(WADLumpPosition(0) = 12), "lump position is 12")
  Check(Bool(WADLumpSize(0) = 4), "lump size is 4")
  Check(Bool(WADLumpDisplayName(0) = "MYLUMP"), "display name is MYLUMP")
  Check(Bool(WADLumpRawNameHex(0) = "4D594C554D500000"), "raw name keeps NUL padding")
  Check(Bool(WADLumpIsMarker(0) = #False), "data lump is not a marker")

  WADClose()
  Check(Bool(WADIsOpen() = #False), "WADClose resets the open state")
  Check(Bool(WADGetLumpCount() = 0), "WADClose releases the directory")
EndProcedure

Procedure Test02ValidPwad()
  Protected path.s = FixturePath("t02_pwad.wad")
  Protected file.i

  BeginCase("T02", "Small valid PWAD")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "PWAD", 1, 16)
  WriteString(file, "PCHK")
  WriteLumpEntry(file, 12, 4, "PATCH")
  CloseFile(file)

  Check(Bool(WADOpen(path) = #True), "WADOpen accepts PWAD")
  Check(Bool(WADGetKind() = #WAD_KindPWAD), "kind is PWAD")
  Check(Bool(WADGetKindName() = "PWAD"), "kind name is PWAD")
  Check(Bool(WADGetLumpCount() = 1), "lump count is 1")
  Check(Bool(WADLumpDisplayName(0) = "PATCH"), "display name is PATCH")
  WADClose()
EndProcedure

Procedure Test03EmptyDirectory()
  Protected path.s = FixturePath("t03_empty.wad")
  Protected file.i

  BeginCase("T03", "Valid 12-byte WAD with zero directory entries")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", 0, 0)
  CloseFile(file)

  ; Convention: with count = 0 the directory offset is unused and may be any
  ; nonnegative value, including offsets past EOF; it is never dereferenced.
  Check(Bool(WADOpen(path) = #True), "empty directory accepted with offset 0")
  Check(Bool(WADGetLumpCount() = 0), "lump count is 0")
  Check(Bool(WADGetFileSize() = 12), "file size is 12 bytes")
  Check(Bool(WADGetDirectoryOffset() = 0), "unused directory offset stored")
  WADClose()

  path = FixturePath("t03_empty_unused_offset.wad")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "second fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", 0, 1234567890)
  CloseFile(file)

  Check(Bool(WADOpen(path) = #True), "empty directory accepted with unused nonnegative offset")
  Check(Bool(WADGetLumpCount() = 0), "no entries allocated for empty directory")
  WADClose()
EndProcedure

Procedure Test04ShortFile()
  Protected path.s
  Protected file.i

  BeginCase("T04", "File shorter than the 12-byte header")
  path = FixturePath("t04_short.wad")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "11-byte fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteString(file, "IWAD")
  WriteZeroBytes(file, 7)
  CloseFile(file)
  CheckRejected(path, "too short", "11-byte file rejected")

  path = FixturePath("t04_zero.wad")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "empty fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  CloseFile(file)
  CheckRejected(path, "too short", "0-byte file rejected")
EndProcedure

Procedure Test05WrongMagic()
  Protected path.s
  Protected file.i

  BeginCase("T05", "Wrong four-byte magic")
  path = FixturePath("t05_badmagic.wad")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "XWAD", 0, 0)
  CloseFile(file)
  CheckRejected(path, "Not a WAD file", "XWAD magic rejected")

  path = FixturePath("t05_lowercase.wad")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "lowercase fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "iwad", 0, 0)
  CloseFile(file)
  CheckRejected(path, "Not a WAD file", "lowercase iwad magic rejected (exact match required)")
EndProcedure

Procedure Test06NegativeHeaderFields()
  Protected path.s
  Protected file.i

  BeginCase("T06", "Negative count and negative directory offset")
  path = FixturePath("t06_negative_count.wad")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", -1, 12)
  CloseFile(file)
  CheckRejected(path, "negative lump count", "negative lump count rejected")

  path = FixturePath("t06_negative_offset.wad")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", 0, -1)
  CloseFile(file)
  CheckRejected(path, "negative directory offset", "negative directory offset rejected")
EndProcedure

Procedure Test07DirectoryPastEof()
  Protected path.s = FixturePath("t07_dir_past_eof.wad")
  Protected file.i

  BeginCase("T07", "Directory offset past end of file")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", 1, 12)
  CloseFile(file)
  CheckRejected(path, "outside the file", "12-byte file cannot hold a directory at offset 12")
EndProcedure

Procedure Test08TruncatedDirectory()
  Protected path.s = FixturePath("t08_truncated_dir.wad")
  Protected file.i

  BeginCase("T08", "Directory truncated (count exceeds available entries)")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", 2, 12)
  WriteLumpEntry(file, 0, 0, "ONE")
  WriteZeroBytes(file, 8)
  CloseFile(file)
  CheckRejected(path, "outside the file", "count 2 with 1.5 entries rejected")
EndProcedure

Procedure Test09OversizedCount()
  Protected path.s
  Protected file.i

  BeginCase("T09", "Oversized count and allocation boundary")
  path = FixturePath("t09_huge_count.wad")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", $7FFFFFFF, 12)
  WriteZeroBytes(file, 16)
  CloseFile(file)
  CheckRejected(path, "too large", "count 0x7FFFFFFF rejected before allocation")

  path = FixturePath("t09_over_limit.wad")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", 1000001, 12)
  WriteZeroBytes(file, 16)
  CloseFile(file)
  CheckRejected(path, "too large", "count one above the safety limit rejected")
EndProcedure

Procedure Test10PayloadPastEof()
  Protected path.s = FixturePath("t10_payload_past_eof.wad")
  Protected file.i

  BeginCase("T10", "Nonempty entry whose payload extends past EOF")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", 1, 12)
  WriteLumpEntry(file, 12, 17, "TOOLONG")
  CloseFile(file)
  CheckRejected(path, "data ends", "entry ending at byte 29 in a 28-byte file rejected")

  ; Range check uses 64-bit arithmetic: position + size must not wrap into a
  ; small or negative 32-bit value that would silently pass the bounds test.
  path = FixturePath("t10_range_overflow.wad")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "overflow fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", 1, 12)
  WriteLumpEntry(file, $7FFFFFF0, 32, "OVERFLOW")
  CloseFile(file)
  CheckRejected(path, "data ends", "position 0x7FFFFFF0 plus size 32 rejected (no 32-bit wrap)")
EndProcedure

Procedure Test11NegativeEntryFields()
  Protected path.s
  Protected file.i

  BeginCase("T11", "Negative payload offset or negative size")
  path = FixturePath("t11_negative_position.wad")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", 1, 12)
  WriteLumpEntry(file, -1, 4, "NEGPOS")
  CloseFile(file)
  CheckRejected(path, "negative position", "negative position rejected")

  path = FixturePath("t11_negative_size.wad")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", 1, 12)
  WriteLumpEntry(file, 12, -4, "NEGSIZE")
  CloseFile(file)
  CheckRejected(path, "negative size", "negative size rejected")
EndProcedure

Procedure Test12ZeroLengthMarker()
  Protected path.s
  Protected file.i

  BeginCase("T12", "Zero-length marker with meaningless payload offsets")
  path = FixturePath("t12_marker_out_of_range.wad")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", 1, 12)
  WriteLumpEntry(file, 999999999, 0, "F_END")
  CloseFile(file)
  Check(Bool(WADOpen(path) = #True), "marker with position past EOF accepted")
  Check(Bool(WADGetLumpCount() = 1), "marker is present in the directory")
  Check(Bool(WADLumpSize(0) = 0), "marker size is 0")
  Check(Bool(WADLumpPosition(0) = 999999999), "raw marker position is preserved")
  Check(Bool(WADLumpIsMarker(0) = #True), "entry is flagged as a marker")
  WADClose()

  path = FixturePath("t12_marker_negative.wad")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", 1, 12)
  WriteLumpEntry(file, -5, 0, "F_START")
  CloseFile(file)
  Check(Bool(WADOpen(path) = #True), "marker with negative position accepted")
  Check(Bool(WADLumpPosition(0) = -5), "negative raw marker position is preserved")
  Check(Bool(WADLumpIsMarker(0) = #True), "entry is flagged as a marker")
  WADClose()
EndProcedure

Procedure Test13EightByteName()
  Protected path.s = FixturePath("t13_name8.wad")
  Protected file.i

  BeginCase("T13", "Exactly 8-byte name without NUL terminator")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", 1, 12)
  WriteLumpEntry(file, 0, 0, "ABCDEFGH")
  CloseFile(file)
  Check(Bool(WADOpen(path) = #True), "8-byte name accepted")
  Check(Bool(WADLumpDisplayName(0) = "ABCDEFGH"), "display name is exactly ABCDEFGH")
  Check(Bool(Len(WADLumpDisplayName(0)) = 8), "display name length is 8")
  Check(Bool(WADLumpRawNameHex(0) = "4142434445464748"), "all eight raw bytes preserved")
  Check(Bool(WADLumpRawNameByte(0, 7) = Asc("H")), "last raw byte has no NUL terminator")
  WADClose()
EndProcedure

Procedure Test14DuplicateAndOverlap()
  Protected path.s = FixturePath("t14_duplicates.wad")
  Protected file.i

  BeginCase("T14", "Duplicate names, unsorted and overlapping payload offsets")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", 2, 20)
  WriteZeroBytes(file, 8)                        ; payload bytes 12..19
  WriteLumpEntry(file, 16, 8, "SAME")            ; 16..23, overlaps next entry
  WriteLumpEntry(file, 12, 8, "SAME")            ; 12..19, sorted after entry 0
  CloseFile(file)

  Check(Bool(WADOpen(path) = #True), "duplicate names and overlapping ranges accepted")
  Check(Bool(WADGetLumpCount() = 2), "both entries present")
  Check(Bool(WADLumpPosition(0) = 16), "directory order keeps entry 0 position")
  Check(Bool(WADLumpPosition(1) = 12), "directory order keeps entry 1 position")
  Check(Bool(WADLumpDisplayName(0) = "SAME"), "entry 0 name preserved")
  Check(Bool(WADLumpDisplayName(1) = "SAME"), "entry 1 name preserved")
  WADClose()
EndProcedure

Procedure Test15Lifecycle()
  Protected path.s = FixturePath("t15_lifecycle.wad")
  Protected badPath.s = FixturePath("t15_badmagic.wad")
  Protected file.i

  BeginCase("T15", "Open / close / reopen and failure followed by success")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", 1, 16)
  WriteString(file, "DATA")
  WriteLumpEntry(file, 12, 4, "LIFE")
  CloseFile(file)

  Check(Bool(WADOpen(path) = #True), "first open succeeds")
  Check(Bool(WADGetLumpCount() = 1), "first open has 1 lump")
  WADClose()
  Check(Bool(WADIsOpen() = #False), "close releases state")

  Check(Bool(WADOpen(path) = #True), "reopen succeeds")
  Check(Bool(WADGetLumpCount() = 1), "reopen still has 1 lump")
  WADClose()

  file = CreateFile(#PB_Any, badPath)
  Check(Bool(file <> 0), "invalid fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "BAD!", 0, 0)
  CloseFile(file)

  Check(Bool(WADOpen(badPath) = #False), "invalid WAD fails after successful use")
  Check(Bool(WADGetLumpCount() = 0), "failure clears previous directory")
  Check(Bool(WADIsOpen() = #False), "failure leaves parser closed")

  Check(Bool(WADOpen(path) = #True), "success after failure works")
  Check(Bool(WADLumpDisplayName(0) = "LIFE"), "name is correct after recovery")
  WADClose()
EndProcedure

Procedure Test16EntryEndsAtEof()
  Protected path.s = FixturePath("t16_exact_eof.wad")
  Protected file.i

  BeginCase("T16", "Nonempty entry ending exactly at file EOF")
  file = CreateFile(#PB_Any, path)
  Check(Bool(file <> 0), "fixture created")
  If file = 0
    ProcedureReturn
  EndIf
  WriteWadHeader(file, "IWAD", 1, 12)
  WriteLumpEntry(file, 12, 16, "EXACT")
  CloseFile(file)

  Check(Bool(WADOpen(path) = #True), "entry ending at fileSize accepted")
  Check(Bool(WADGetFileSize() = 28), "file size is 28 bytes")
  Check(Bool(WADLumpPosition(0) = 12), "position is 12")
  Check(Bool(WADLumpSize(0) = 16), "size is 16")
  WADClose()
EndProcedure

; ---------------------------------------------------------------------------
; Main
; ---------------------------------------------------------------------------

OpenConsole()
PrintN("DoomPB WAD header/directory tests (M1-01)")

If PrepareFixtureDirectory() = #False
  PrintN("FAIL: cannot create fixture directory at " + gFixtureDirectory)
  End 1
EndIf
PrintN("Fixture directory: " + gFixtureDirectory)

TestEndianHelpers()
Test01ValidIwad()
Test02ValidPwad()
Test03EmptyDirectory()
Test04ShortFile()
Test05WrongMagic()
Test06NegativeHeaderFields()
Test07DirectoryPastEof()
Test08TruncatedDirectory()
Test09OversizedCount()
Test10PayloadPastEof()
Test11NegativeEntryFields()
Test12ZeroLengthMarker()
Test13EightByteName()
Test14DuplicateAndOverlap()
Test15Lifecycle()
Test16EntryEndsAtEof()

WADClose()
CleanupFixtureDirectory()

PrintN("")
PrintN("Test cases: " + Str(gCaseCount) + ", assertions: " + Str(gAssertionCount) + ", failures: " + Str(gFailureCount))
If gFailureCount = 0
  PrintN("RESULT: PASS")
  End 0
EndIf

PrintN("RESULT: FAIL")
End gFailureCount
