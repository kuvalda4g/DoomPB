; -----------------------------------------------------------------------------
; DoomPB - fixed-point 16.16 unit tests (M3-01)
; Copyright (C) 2026 DoomPB contributors
; SPDX-License-Identifier: GPL-2.0-only
;
; Standalone math suite: this entry point includes only src/Core/Fixed.pbi.
; No WAD, palette, graphics, map, renderer, window or commercial asset is
; required. All fixtures are numeric and generated by this program.
;
; FM01-FM40 cover constants, conversions, FixedMul, FixedDiv, checked FixedDiv2,
; negative shifts, 32-bit wrap, differential division and repeatability.
; FI01-FI03 cover standalone inclusion, a synthetic map-coordinate bridge and a
; deterministic repeat after an intentional checked-division failure.
;
; Expected values come from independent oracles:
;   - multiplication: 64-bit integer division/remainder floor, not the >> path;
;   - division: the original guard expressed with widened magnitudes and an
;     alternate /16384 comparison, plus the active C double quotient formula
;     (test-only reference, truncated with Int()).
; The differential sample uses a documented fixed LCG seed, not a system seed.
;
; Exit code: 0 when every assertion passed, otherwise the number of failures.
; -----------------------------------------------------------------------------

EnableExplicit

XIncludeFile "../../src/Core/Fixed.pbi"

#TEST_LongBytes = 4
#TEST_LcgSeed = $12345678
#TEST_LcgMultiplier = 1103515245
#TEST_LcgAddend = 12345
#TEST_GuardDivisor = 16384

Global gCaseCount.i = 0
Global gAssertionCount.i = 0
Global gFailureCount.i = 0
Global gLcgState.q = #TEST_LcgSeed

; ---------------------------------------------------------------------------
; Harness
; ---------------------------------------------------------------------------

Procedure BeginCase(Id.s, Title.s)
  gCaseCount + 1
  PrintN("")
  PrintN("[" + Id + "] " + Title)
EndProcedure

Procedure Check(Ok.i, Description.s)
  gAssertionCount + 1
  If Ok
    PrintN("  PASS: " + Description)
  Else
    PrintN("  FAIL: " + Description)
    gFailureCount + 1
  EndIf
EndProcedure

; Canonical signed32 bit-pattern cleanup for diagnostics only; no negative
; Hex() formatting ambiguity is involved because the low word is masked first.
Procedure.s SignedBitHex(Value.l)
  Protected wide.q = Value
  Protected low.q = wide & $FFFFFFFF

  ProcedureReturn Hex(low)
EndProcedure

; ---------------------------------------------------------------------------
; Independent oracles (test-only, never production dependencies)
; ---------------------------------------------------------------------------

; Explicit low-32 two's-complement cleanup written independently in the test
; source. FM39 also asserts the signed expectations directly, so this is not
; merely a call of the production wrap helper under another name.
Procedure.l TestWrap32Low(Value.q)
  Protected bits.q = Value & $FFFFFFFF

  If bits >= $80000000
    bits = bits - $100000000
  EndIf

  ProcedureReturn bits
EndProcedure

; Floor of value/65536 expressed with integer division and remainder. PureBasic
; / truncates toward zero and % keeps the dividend sign (verified with compiler
; probes), so a negative non-multiple needs one extra subtraction.
Procedure.q OracleFloorProduct(Product.q)
  Protected truncated.q = Product / #FRACUNIT
  Protected remainder.q = Product % #FRACUNIT

  If Product < 0 And remainder <> 0
    truncated = truncated - 1
  EndIf

  ProcedureReturn truncated
EndProcedure

; Independent FixedMul oracle: widened product, division/remainder floor, then
; the documented low-32 wrap. It never uses the production shift path.
Procedure.l OracleFixedMul(A.l, B.l)
  Protected wideA.q = A
  Protected wideB.q = B
  Protected product.q = wideA * wideB
  Protected floored.q = OracleFloorProduct(product)

  ProcedureReturn TestWrap32Low(floored)
EndProcedure

; Independent sign-mismatch predicate. It uses separate negative flags rather
; than the production's (a ! b) < 0 expression shape.
Procedure.i OracleSignsDiffer(A.l, B.l)
  Protected aNegative.i
  Protected bNegative.i

  If A < 0
    aNegative = 1
  EndIf
  If B < 0
    bNegative = 1
  EndIf
  If aNegative <> bNegative
    ProcedureReturn 1
  EndIf

  ProcedureReturn 0
EndProcedure

; Guard-equivalent independent comparison: for nonnegative widened magnitudes,
; /16384 equals the original >>14 floor. Production uses >>14; the oracle uses
; division to avoid sharing the same expression.
Procedure.l OracleFixedDiv(A.l, B.l)
  Protected wideA.q = A
  Protected wideB.q = B
  Protected magnitudeA.q = wideA
  Protected magnitudeB.q = wideB
  Protected da.d
  Protected db.d
  Protected c.d
  Protected truncated.i
  Protected result.l

  If magnitudeA < 0
    magnitudeA = -magnitudeA
  EndIf
  If magnitudeB < 0
    magnitudeB = -magnitudeB
  EndIf

  If (magnitudeA / #TEST_GuardDivisor) >= magnitudeB
    ; For nonnegative magnitudes /16384 is exactly the original >>14 floor.
    ; This deliberately uses a division expression, not the production shift.
    If OracleSignsDiffer(A, B)
      ProcedureReturn #FIXED_MIN
    Else
      ProcedureReturn #FIXED_MAX
    EndIf
  EndIf

  da = A
  db = B
  c = da / db * 65536.0
  truncated = Int(c)
  result = truncated
  ProcedureReturn result
EndProcedure

; Reference evaluation of the original active FixedDiv2 predicate and its
; in-range truncated value. Outputs are caller-owned: Failure=1 means the
; original would call I_Error; Expected holds the double-truncated result when
; valid. This oracle trusts only a nonzero denominator.
Procedure.i OracleDiv2Reference(A.l, B.l, *Expected.Long, *Failure.Long)
  Protected da.d = A
  Protected db.d = B
  Protected c.d
  Protected truncated.i

  If *Expected = 0 Or *Failure = 0
    ProcedureReturn #False
  EndIf

  If db = 0.0
    *Failure\l = 1
    ProcedureReturn #True
  EndIf

  c = da / db * 65536.0
  If c >= 2147483648.0 Or c < -2147483648.0
    *Failure\l = 1
    ProcedureReturn #True
  EndIf

  *Failure\l = 0
  truncated = Int(c)
  *Expected\l = truncated
  ProcedureReturn #True
EndProcedure

; ---------------------------------------------------------------------------
; Fixed-seed deterministic source (not Random(), not any system seed)
; ---------------------------------------------------------------------------

Procedure.q NextLcgWord()
  gLcgState = (gLcgState * #TEST_LcgMultiplier + #TEST_LcgAddend) & $FFFFFFFF
  ProcedureReturn gLcgState
EndProcedure

Procedure.l NextSigned32()
  Protected raw.q = NextLcgWord()
  Protected value.q = raw

  If value >= $80000000
    value = value - $100000000
  EndIf

  ProcedureReturn value
EndProcedure

; Signed 16-bit-style value from the low word: the map-coordinate-like domain.
Procedure.l NextSigned16()
  Protected raw.q = NextLcgWord()
  Protected limited.q = raw & $FFFF

  If limited >= $8000
    limited = limited - $10000
  EndIf

  ProcedureReturn limited
EndProcedure

; ---------------------------------------------------------------------------
; Reusable oracle comparison helpers
; ---------------------------------------------------------------------------

Procedure CheckMulVsOracle(A.l, B.l)
  Protected actual.l = FixedMul(A, B)
  Protected expected.l = OracleFixedMul(A, B)

  Check(Bool(actual = expected),
        "FixedMul(" + Str(A) + ", " + Str(B) + ") = " + Str(actual) +
        "; independent floor oracle = " + Str(expected))
EndProcedure

Procedure CheckDivPair(A.l, B.l)
  Protected fixedActual.l = FixedDiv(A, B)
  Protected fixedOracle.l = OracleFixedDiv(A, B)
  Protected checkedResult.l = 777
  Protected checkedOk.i
  Protected doubleExpected.l = 0
  Protected doubleFailure.l = 0
  Protected oracleComputed.i
  Protected predicateAgrees.i = 0

  oracleComputed = OracleDiv2Reference(A, B, @doubleExpected, @doubleFailure)
  checkedOk = FixedDiv2Checked(A, B, @checkedResult)

  If checkedOk
    If doubleFailure = 0
      predicateAgrees = 1
    EndIf
  Else
    If doubleFailure = 0
      predicateAgrees = 0
    Else
      predicateAgrees = 1
    EndIf
  EndIf

  Check(Bool(oracleComputed),
        "double reference predicate is computable for (" + Str(A) + ", " + Str(B) + ")")
  Check(Bool(fixedActual = fixedOracle),
        "FixedDiv(" + Str(A) + ", " + Str(B) + ") = " + Str(fixedActual) +
        "; guarded oracle = " + Str(fixedOracle))
  Check(predicateAgrees,
        "FixedDiv2Checked(" + Str(A) + ", " + Str(B) + ") success/failure matches double predicate")
  If checkedOk
    Check(Bool(checkedResult = doubleExpected),
          "checked quotient " + Str(checkedResult) + " matches double truncation " + Str(doubleExpected))
  Else
    Check(Bool(checkedResult = 777),
          "failed checked call leaves result untouched (" + Str(checkedResult) + ")")
  EndIf
EndProcedure

; ---------------------------------------------------------------------------
; FM01 - FM40
; ---------------------------------------------------------------------------

Procedure TestFM01Constants()
  BeginCase("FM01", "Fixed 16.16 constants and signed 32-bit type")
  Check(Bool(#FRACBITS = 16), "#FRACBITS is 16")
  Check(Bool(#FRACUNIT = 65536), "#FRACUNIT is 1<<16 = 65536")
  Check(Bool(#FIXED_MIN = -2147483648), "#FIXED_MIN is signed32 minimum")
  Check(Bool(#FIXED_MAX = 2147483647), "#FIXED_MAX is signed32 maximum")
  Check(Bool(#FIXED_INT_MIN = -32768), "integer map-unit minimum is -32768")
  Check(Bool(#FIXED_INT_MAX = 32767), "integer map-unit maximum is +32767")
  Check(Bool(FixedMul(#FRACUNIT, #FRACUNIT) = #FRACUNIT), "1.0 * 1.0 = 1.0 in 16.16")
  Check(Bool(FixedMul(32768, #FRACUNIT) = 32768), "0.5 * 1.0 = 0.5")
  Check(Bool(FixedMul(-32768, #FRACUNIT) = -32768), "-0.5 * 1.0 = -0.5")
  Check(Bool(Str(#FIXED_MIN) = "-2147483648"), "constant prints as signed -2147483648")
  Check(Bool(Str(#FIXED_MAX) = "2147483647"), "constant prints as signed 2147483647")
EndProcedure

Procedure TestFM02MapUnitConversion()
  BeginCase("FM02", "Checked integer/map-unit conversion to 16.16")
  Protected result.l = 0

  Check(Bool(FixedFromIntChecked(-32768, @result)), "-32768 converts")
  Check(Bool(result = #FIXED_MIN), "-32768 -> -2147483648 exactly")
  Check(Bool(result = -32768 * #FRACUNIT), "-32768 bits equal -32768*65536")

  result = 0
  Check(Bool(FixedFromIntChecked(-1, @result)), "-1 converts")
  Check(Bool(result = -65536), "-1 -> -65536 exactly")

  result = 0
  Check(Bool(FixedFromIntChecked(0, @result)), "0 converts")
  Check(Bool(result = 0), "0 -> 0 exactly")

  result = 0
  Check(Bool(FixedFromIntChecked(1, @result)), "+1 converts")
  Check(Bool(result = 65536), "+1 -> 65536 exactly")

  result = 0
  Check(Bool(FixedFromIntChecked(32767, @result)), "+32767 converts")
  Check(Bool(result = 2147418112), "+32767 -> 2147418112 exactly")
EndProcedure

Procedure TestFM03ConversionFailures()
  BeginCase("FM03", "Conversion failures leave output intact")
  Protected result.l = 77

  Check(Bool(FixedFromIntChecked(32768, @result) = #False), "+32768 cannot fit 16.16")
  Check(Bool(result = 77), "output is intact after +32768 failure")
  Check(Bool(FindString(FixedLastError(), "cannot be represented") > 0),
        "diagnostic explains the representable range")

  result = 77
  Check(Bool(FixedFromIntChecked(-32769, @result) = #False), "-32769 cannot fit 16.16")
  Check(Bool(result = 77), "output is intact after -32769 failure")

  result = 77
  Check(Bool(FixedFromIntChecked(2147483648, @result) = #False), "huge positive value cannot fit")
  Check(Bool(result = 77), "output is intact after a huge positive value failure")
EndProcedure

Procedure TestFM04IntegerFloor()
  BeginCase("FM04", "Integer floor extraction equals arithmetic >>16")
  Check(Bool(FixedToIntFloor(-1) = -1), "fixed -1 floors to integer -1")
  Check(Bool(FixedToIntFloor(-65537) = -2), "fixed -65537 floors to integer -2")
  Check(Bool(FixedToIntFloor(-65536) = -1), "fixed -65536 floors to integer -1")
  Check(Bool(FixedToIntFloor(0) = 0), "fixed 0 floors to integer 0")
  Check(Bool(FixedToIntFloor(65535) = 0), "fixed 65535 (sub-unit) floors to 0")
  Check(Bool(FixedToIntFloor(65536) = 1), "fixed 65536 floors to integer 1")
  Check(Bool(FixedToIntFloor(#FIXED_MIN) = -32768), "signed32 minimum floors to -32768")
  Check(Bool(FixedToIntFloor(#FIXED_MAX) = 32767), "signed32 maximum floors to 32767")
EndProcedure

Procedure TestFM05OptionalTruncation()
  BeginCase("FM05", "Optional integer extraction truncated toward zero")
  Check(Bool(FixedToIntTrunc(-1) = 0), "fixed -1 truncates to 0 (not arithmetic floor)")
  Check(Bool(FixedToIntTrunc(-65537) = -1), "fixed -65537 truncates to -1")
  Check(Bool(FixedToIntTrunc(-65536) = -1), "fixed -65536 truncates to -1")
  Check(Bool(FixedToIntTrunc(65535) = 0), "fixed 65535 truncates to 0")
  Check(Bool(FixedToIntTrunc(65536) = 1), "fixed 65536 truncates to 1")
  Check(Bool(FixedToIntTrunc(-32768) = 0), "fixed -32768 (-0.5) truncates to 0")
EndProcedure

Procedure TestFM06ZeroMultiply()
  BeginCase("FM06", "FixedMul(x,0)=0 for small and extreme values")
  Check(Bool(FixedMul(0, 0) = 0), "FixedMul(0,0)=0")
  Check(Bool(FixedMul(1, 0) = 0), "FixedMul(1,0)=0")
  Check(Bool(FixedMul(-1, 0) = 0), "FixedMul(-1,0)=0")
  Check(Bool(FixedMul(32767, 0) = 0), "FixedMul(32767,0)=0")
  Check(Bool(FixedMul(-32768, 0) = 0), "FixedMul(-32768,0)=0")
  Check(Bool(FixedMul(#FIXED_MAX, 0) = 0), "FixedMul(max,0)=0")
  Check(Bool(FixedMul(#FIXED_MIN, 0) = 0), "FixedMul(min,0)=0")
  Check(Bool(FixedMul(0, #FIXED_MIN) = 0), "FixedMul(0,min)=0")
EndProcedure

Procedure TestFM07UnitMultiply()
  BeginCase("FM07", "FixedMul(x,FRACUNIT)=x across signed range")
  Check(Bool(FixedMul(#FIXED_MIN, #FRACUNIT) = #FIXED_MIN), "min * 1.0 = min")
  Check(Bool(FixedMul(-1073741824, #FRACUNIT) = -1073741824), "-2^30 * 1.0 unchanged")
  Check(Bool(FixedMul(-65536, #FRACUNIT) = -65536), "-1.0 * 1.0 = -1.0")
  Check(Bool(FixedMul(-1, #FRACUNIT) = -1), "tiny negative fixed * 1.0 unchanged")
  Check(Bool(FixedMul(0, #FRACUNIT) = 0), "0 * 1.0 = 0")
  Check(Bool(FixedMul(1, #FRACUNIT) = 1), "tiny positive fixed * 1.0 unchanged")
  Check(Bool(FixedMul(65536, #FRACUNIT) = 65536), "1.0 * 1.0 unchanged")
  Check(Bool(FixedMul(1073741823, #FRACUNIT) = 1073741823), "near-2^30 positive unchanged")
  Check(Bool(FixedMul(#FIXED_MAX, #FRACUNIT) = #FIXED_MAX), "max * 1.0 = max")
EndProcedure

Procedure TestFM08PositiveHalf()
  BeginCase("FM08", "Positive half multiply")
  Check(Bool(FixedMul(32768, 32768) = 16384), "0.5 * 0.5 = 0.25 (16384)")
  Check(Bool(FixedMul(16384, 32768) = 8192), "0.25 * 0.5 = 0.125")
EndProcedure

Procedure TestFM09NegativeHalf()
  BeginCase("FM09", "Negative half multiply")
  Check(Bool(FixedMul(-32768, 32768) = -16384), "-0.5 * 0.5 = -0.25")
  Check(Bool(FixedMul(-16384, 32768) = -8192), "-0.25 * 0.5 = -0.125")
EndProcedure

Procedure TestFM10PositiveFractional()
  BeginCase("FM10", "Positive fractional product rounds down")
  Check(Bool(FixedMul(3, 21846) = 1), "3.0/65536 * 21846.0/65536 floors from 65538/65536 to 1")
  CheckMulVsOracle(3, 21846)
  CheckMulVsOracle(65537, 1)
EndProcedure

Procedure TestFM11NegativeFractional()
  BeginCase("FM11", "Negative fractional product floors, not truncates")
  Check(Bool(FixedMul(1, -1) = -1), "FixedMul(1,-1) = -1 (not 0)")
  Check(Bool(FixedMul(65536, -1) = -1), "FixedMul(1.0,-1) = -1")
  Check(Bool(FixedMul(1, -65536) = -1), "FixedMul(1,-1.0) = -1")
EndProcedure

Procedure TestFM12TinyDoubleNegative()
  BeginCase("FM12", "Tiny double negative product")
  Check(Bool(FixedMul(-1, -1) = 0), "FixedMul(-1,-1) = 0")
  Check(Bool(FixedMul(-1, 1) = -1), "FixedMul(-1,1) = -1")
  Check(Bool(FixedMul(1, 1) = 0), "FixedMul(1,1) = 0")
EndProcedure

Procedure TestFM13HighPositiveProduct()
  BeginCase("FM13", "High positive product wraps to -65536")
  Check(Bool(FixedMul(#FIXED_MAX, #FIXED_MAX) = -65536), "max*max floor equals low32 FFFF0000 = -65536")
  Check(Bool(SignedBitHex(FixedMul(#FIXED_MAX, #FIXED_MAX)) = "FFFF0000"),
        "exact low32 bit pattern of max*max is FFFF0000")
EndProcedure

Procedure TestFM14ExtremeNegativeProduct()
  BeginCase("FM14", "Extreme negative product wraps to zero")
  Check(Bool(FixedMul(#FIXED_MIN, #FIXED_MIN) = 0), "min*min floor equals low32 00000000 = 0")
  Check(Bool(SignedBitHex(FixedMul(#FIXED_MIN, #FIXED_MIN)) = "0"),
        "exact low32 bit pattern of min*min is zero")
EndProcedure

Procedure TestFM15MixedExtremeProduct()
  BeginCase("FM15", "Mixed extreme product with FRACUNIT")
  Check(Bool(FixedMul(#FIXED_MIN, #FRACUNIT) = #FIXED_MIN), "min * 1.0 stays min")
  Check(Bool(FixedMul(#FIXED_MAX, #FRACUNIT) = #FIXED_MAX), "max * 1.0 stays max")
EndProcedure

Procedure TestFM16Commutativity()
  BeginCase("FM16", "FixedMul commutativity for representative pairs")
  Check(Bool(FixedMul(1, -1) = FixedMul(-1, 1)), "(1,-1) commutative")
  Check(Bool(FixedMul(65536, 32768) = FixedMul(32768, 65536)), "(1.0,0.5) commutative")
  Check(Bool(FixedMul(-32768, 32768) = FixedMul(32768, -32768)), "(-0.5,0.5) commutative")
  Check(Bool(FixedMul(#FIXED_MAX, 3) = FixedMul(3, #FIXED_MAX)), "(max,3) commutative")
  Check(Bool(FixedMul(#FIXED_MIN, #FRACUNIT) = FixedMul(#FRACUNIT, #FIXED_MIN)), "(min,1.0) commutative")
  Check(Bool(FixedMul(12345, -6789) = FixedMul(-6789, 12345)), "(12345,-6789) commutative")
EndProcedure

Procedure TestFM17ExhaustiveTinyDomain()
  BeginCase("FM17", "Exhaustive tiny domain [-32,32] against floor oracle")
  Protected a.l
  Protected b.l
  Protected actual.l
  Protected expected.l
  Protected mismatches.i = 0
  Protected checked.i = 0

  For a = -32 To 32
    For b = -32 To 32
      actual = FixedMul(a, b)
      expected = OracleFixedMul(a, b)
      checked + 1
      If actual <> expected
        mismatches + 1
        If mismatches <= 5
          PrintN("    mismatch: a=" + Str(a) + " b=" + Str(b) +
                 " actual=" + Str(actual) + " oracle=" + Str(expected))
        EndIf
      EndIf
    Next
  Next

  Check(Bool(checked = 4225), "all 65x65 pairs were evaluated (4225)")
  Check(Bool(mismatches = 0), "all tiny-domain pairs match the floor oracle")
EndProcedure

Procedure TestFM18BitPatternSpread()
  BeginCase("FM18", "Deterministic positive/negative/near-limit operand spread")
  CheckMulVsOracle(1, -1)
  CheckMulVsOracle(-1, -1)
  CheckMulVsOracle(32768, -32768)
  CheckMulVsOracle(65536, 65536)
  CheckMulVsOracle(#FIXED_MIN, #FIXED_MIN)
  CheckMulVsOracle(#FIXED_MAX, #FIXED_MAX)
  CheckMulVsOracle(#FIXED_MIN, #FRACUNIT)
  CheckMulVsOracle(#FIXED_MAX, #FRACUNIT)
  CheckMulVsOracle(#FIXED_MAX, 65537)
  CheckMulVsOracle(#FIXED_MIN, 65537)
  CheckMulVsOracle(1073741824, 65536)
  CheckMulVsOracle(12345, -98765)
  CheckMulVsOracle(3, 21846)
  CheckMulVsOracle(0, #FIXED_MIN)
  CheckMulVsOracle(-32768, 32767)
EndProcedure

Procedure TestFM19DivideByUnit()
  BeginCase("FM19", "FixedDiv(x,FRACUNIT) for representative valid x")
  Check(Bool(FixedDiv(0, #FRACUNIT) = 0), "0 / 1.0 = 0")
  Check(Bool(FixedDiv(1, #FRACUNIT) = 1), "1 / 1.0 = 0.000015 fixed")
  Check(Bool(FixedDiv(-1, #FRACUNIT) = -1), "-1 / 1.0 = -0.000015 fixed")
  Check(Bool(FixedDiv(65536, #FRACUNIT) = 65536), "1.0 / 1.0 = 1.0")
  Check(Bool(FixedDiv(-65536, #FRACUNIT) = -65536), "-1.0 / 1.0 = -1.0")
  Check(Bool(FixedDiv(32767, #FRACUNIT) = 32767), "+integer 32767 / 1.0 unchanged")
  Check(Bool(FixedDiv(-32768, #FRACUNIT) = -32768), "-integer 32768 / 1.0 unchanged")
  Check(Bool(FixedDiv(1073741823, #FRACUNIT) = 1073741823), "near-2^30 value below guard unchanged")
  Check(Bool(FixedDiv(-1073741823, #FRACUNIT) = -1073741823), "negative near-2^30 value unchanged")
EndProcedure

Procedure TestFM20DivideHalvesDoubles()
  BeginCase("FM20", "FixedDiv with half and double denominators")
  Check(Bool(FixedDiv(#FRACUNIT, 32768) = 131072), "1.0 / 0.5 = 2.0 (131072)")
  Check(Bool(FixedDiv(32768, #FRACUNIT) = 32768), "0.5 / 1.0 = 0.5")
  Check(Bool(FixedDiv(131072, #FRACUNIT) = 131072), "2.0 / 1.0 = 2.0")
  Check(Bool(FixedDiv(#FRACUNIT, 131072) = 32768), "1.0 / 2.0 = 0.5")
EndProcedure

Procedure TestFM21DivideSigns()
  BeginCase("FM21", "Divide sign combinations ++, +-, -+, --")
  Check(Bool(FixedDiv(65536, 32768) = 131072), "++ gives positive double")
  Check(Bool(FixedDiv(65536, -32768) = -131072), "+- gives negative double")
  Check(Bool(FixedDiv(-65536, 32768) = -131072), "-+ gives negative double")
  Check(Bool(FixedDiv(-65536, -32768) = 131072), "-- gives positive double")
EndProcedure

Procedure TestFM22PositiveQuotientTruncation()
  BeginCase("FM22", "Positive quotient truncation")
  Check(Bool(FixedDiv(1, 3) = 21845), "FixedDiv(1,3) = 21845")
  Check(Bool(FixedDiv(2, 3) = 43690), "FixedDiv(2,3) truncates 43690.666")
EndProcedure

Procedure TestFM23NegativeQuotientTruncation()
  BeginCase("FM23", "Negative quotient truncation toward zero")
  Check(Bool(FixedDiv(1, -3) = -21845), "FixedDiv(1,-3) = -21845")
  Check(Bool(FixedDiv(2, -3) = -43690), "FixedDiv(2,-3) truncates -43690.666")
  Check(Bool(FixedDiv(-1, -3) = 21845), "FixedDiv(-1,-3) = 21845")
EndProcedure

Procedure TestFM24PositiveOverflowGuard()
  BeginCase("FM24", "Positive guard saturation")
  Check(Bool(FixedDiv(16384, 1) = #FIXED_MAX), "FixedDiv(16384,1) saturates to MAX")
  Check(Bool(FixedDiv(65536, 1) = #FIXED_MAX), "FixedDiv(1.0,1) saturates to MAX")
  Check(Bool(FixedDiv(#FIXED_MAX, 1) = #FIXED_MAX), "FixedDiv(max,1) saturates to MAX")
EndProcedure

Procedure TestFM25NegativeOverflowGuard()
  BeginCase("FM25", "Negative guard saturation with sign mismatch")
  Check(Bool(FixedDiv(-16384, 1) = #FIXED_MIN), "FixedDiv(-16384,1) saturates to MIN")
  Check(Bool(FixedDiv(-65536, 1) = #FIXED_MIN), "FixedDiv(-1.0,1) saturates to MIN")
  Check(Bool(FixedDiv(#FIXED_MIN, 1) = #FIXED_MIN), "FixedDiv(min,1) saturates to MIN")
EndProcedure

Procedure TestFM26ConservativeGuard()
  BeginCase("FM26", "Conservative early guard before a fitting quotient")
  Check(Bool(FixedDiv(16384, 1) = #FIXED_MAX),
        "16384/1 yields MAX although true quotient 1073741824 fits signed32")
  Check(Bool(FixedDiv(16384, -1) = #FIXED_MIN),
        "16384/-1 yields MIN under the original guard (sign mismatch)")
  Check(Bool(FixedDiv(-16384, -1) = #FIXED_MAX),
        "-16384/-1 yields MAX under the original guard (signs agree)")
EndProcedure

Procedure TestFM27ThresholdBelowGuard()
  BeginCase("FM27", "Magnitude just below the guard threshold")
  Check(Bool(FixedDiv(16383, 1) = 1073676288), "FixedDiv(16383,1) = 1073676288")
  Check(Bool(FixedDiv(16383, 2) = 536838144), "FixedDiv(16383,2) = 536838144")
  Check(Bool(FixedDiv(32766, 2) = 1073676288), "FixedDiv(32766,2) threshold behaves equivalently")
  Check(Bool(FixedDiv(16383, -1) = -1073676288), "FixedDiv(16383,-1) = -1073676288")
EndProcedure

Procedure TestFM28PositiveZero()
  BeginCase("FM28", "Positive numerator / zero denominator")
  Check(Bool(FixedDiv(123, 0) = #FIXED_MAX), "FixedDiv(123,0) = MAX")
  Check(Bool(FixedDiv(1, 0) = #FIXED_MAX), "FixedDiv(1,0) = MAX")
  Check(Bool(FixedDiv(#FIXED_MAX, 0) = #FIXED_MAX), "FixedDiv(max,0) = MAX")
EndProcedure

Procedure TestFM29NegativeZero()
  BeginCase("FM29", "Negative numerator / zero denominator")
  Check(Bool(FixedDiv(-123, 0) = #FIXED_MIN), "FixedDiv(-123,0) = MIN")
  Check(Bool(FixedDiv(-1, 0) = #FIXED_MIN), "FixedDiv(-1,0) = MIN")
  Check(Bool(FixedDiv(#FIXED_MIN, 0) = #FIXED_MIN), "FixedDiv(min,0) = MIN")
EndProcedure

Procedure TestFM30ZeroZero()
  BeginCase("FM30", "Zero / zero")
  Check(Bool(FixedDiv(0, 0) = #FIXED_MAX), "FixedDiv(0,0) = MAX")
EndProcedure

Procedure TestFM31ZeroNonzero()
  BeginCase("FM31", "Zero numerator / signed nonzero denominator")
  Check(Bool(FixedDiv(0, #FRACUNIT) = 0), "0 / 1.0 = 0")
  Check(Bool(FixedDiv(0, -#FRACUNIT) = 0), "0 / -1.0 = 0")
  Check(Bool(FixedDiv(0, 1) = 0), "0 / 1 = 0")
  Check(Bool(FixedDiv(0, -1) = 0), "0 / -1 = 0")
  Check(Bool(FixedDiv(0, #FIXED_MIN) = 0), "0 / min = 0")
EndProcedure

Procedure TestFM32IntMinNumerator()
  BeginCase("FM32", "Signed32 minimum numerator with safe magnitude")
  Check(Bool(FixedDiv(#FIXED_MIN, #FIXED_MIN) = 65536), "min/min = 1.0 (65536)")
  Check(Bool(FixedDiv(#FIXED_MIN, #FIXED_MAX) = -65536), "min/max truncates to -65536")
  Check(Bool(FixedDiv(#FIXED_MIN, 2) = #FIXED_MIN), "min/2 saturates under mismatch-free guard")
EndProcedure

Procedure TestFM33IntMinDivisor()
  BeginCase("FM33", "Signed32 minimum divisor produces defined quotients")
  Check(Bool(FixedDiv(1, #FIXED_MIN) = 0), "FixedDiv(1,min) truncates to 0")
  Check(Bool(FixedDiv(0, #FIXED_MIN) = 0), "FixedDiv(0,min) = 0")
  Check(Bool(FixedDiv(#FIXED_MAX, #FIXED_MIN) = -65535), "max/min truncates to -65535")
  Check(Bool(FixedDiv(-#FIXED_MAX, #FIXED_MIN) = 65535), "-max/min truncates to 65535")
  Check(Bool(FixedDiv(#FIXED_MIN, #FIXED_MIN) = 65536), "min/min defined quotient 65536")
EndProcedure

Procedure TestFM34CheckedDiv2Zero()
  BeginCase("FM34", "Checked FixedDiv2 rejects a zero denominator safely")
  Protected result.l = 77
  Check(Bool(FixedDiv2Checked(123, 0, @result) = #False), "zero denominator returns False, no crash")
  Check(Bool(result = 77), "result is untouched on divide-by-zero failure")
  Check(Bool(FindString(FixedLastError(), "denominator is zero") > 0),
        "diagnostic names the zero denominator")
  Check(Bool(FixedDiv2Checked(0, 0, @result) = #False), "0/0 also returns False")
EndProcedure

Procedure TestFM35CheckedDiv2Overflow()
  BeginCase("FM35", "Checked FixedDiv2 rejects out-of-range quotients")
  Protected result.l = 77
  Check(Bool(FixedDiv2Checked(32768, 1, @result) = #False),
        "32768/1 quotient 2147483648 is out of range (returns False)")
  Check(Bool(result = 77), "positive overflow leaves result untouched")
  Check(Bool(FindString(FixedLastError(), "outside") > 0),
        "diagnostic identifies the signed32 fixed range")

  result = 77
  Check(Bool(FixedDiv2Checked(#FIXED_MIN, 1, @result) = #False),
        "min/1 quotient -140737488355328 is out of range (returns False)")
  Check(Bool(result = 77), "negative overflow leaves result untouched")
EndProcedure

Procedure TestFM36CheckedDiv2ExactMinimum()
  BeginCase("FM36", "Exact -2147483648 quotient is valid, not overflow")
  Protected result.l = 77
  Check(Bool(FixedDiv2Checked(-32768, 1, @result) = #True),
        "-32768/1 is accepted (exact signed32 minimum)")
  Check(Bool(result = #FIXED_MIN), "result is exactly -2147483648")
  Check(Bool(FixedLastError() = ""), "successful checked call clears the error")

  result = 77
  Check(Bool(FixedDiv2Checked(#FIXED_MIN, #FRACUNIT, @result) = #True),
        "min/1.0 is accepted (exact signed32 minimum)")
  Check(Bool(result = #FIXED_MIN), "min/1.0 result is exactly -2147483648")
EndProcedure

Procedure TestFM37DifferentialDivision()
  BeginCase("FM37", "Differential division against independent guarded oracle")
  Protected a.l
  Protected b.l
  Protected fixedActual.l
  Protected fixedOracle.l
  Protected checkedResult.l = 777
  Protected checkedOk.i
  Protected doubleExpected.l = 0
  Protected doubleFailure.l = 0
  Protected oracleComputed.i
  Protected mismatchFixed.i = 0
  Protected mismatchChecked.i = 0
  Protected compared.i = 0

  ; Mandatory boundary/threshold vectors, checked individually with independent
  ; oracle expectations. Seed is reset so the random portion is deterministic.
  CheckDivPair(#FIXED_MIN, #FIXED_MIN)
  CheckDivPair(#FIXED_MIN, #FIXED_MAX)
  CheckDivPair(#FIXED_MAX, #FIXED_MIN)
  CheckDivPair(#FIXED_MIN, 1)
  CheckDivPair(-16384, 1)
  CheckDivPair(16384, 1)
  CheckDivPair(16383, 1)
  CheckDivPair(16384, -1)
  CheckDivPair(-16384, -1)
  CheckDivPair(123, 0)
  CheckDivPair(-123, 0)
  CheckDivPair(0, 0)
  CheckDivPair(1, 3)
  CheckDivPair(1, -3)
  CheckDivPair(0, #FRACUNIT)

  gLcgState = #TEST_LcgSeed
  For compared = 1 To 10000
    If (compared % 2) = 0
      ; Alternating half domain keeps the non-guard double path well covered.
      a = NextSigned16()
      b = NextSigned16()
    Else
      a = NextSigned32()
      b = NextSigned32()
    EndIf

    fixedActual = FixedDiv(a, b)
    fixedOracle = OracleFixedDiv(a, b)
    checkedResult = 777
    checkedOk = FixedDiv2Checked(a, b, @checkedResult)
    oracleComputed = OracleDiv2Reference(a, b, @doubleExpected, @doubleFailure)

    If fixedActual <> fixedOracle
      mismatchFixed + 1
      If mismatchFixed <= 5
        PrintN("    FixedDiv mismatch: a=" + Str(a) + " b=" + Str(b) +
               " actual=" + Str(fixedActual) + " oracle=" + Str(fixedOracle))
      EndIf
    EndIf

    If checkedOk
      If doubleFailure <> 0
        mismatchChecked + 1
        If mismatchChecked <= 5
          PrintN("    FixedDiv2Checked predicate mismatch: a=" + Str(a) +
                 " b=" + Str(b) + " checked=True referenceFailure=" + Str(doubleFailure))
        EndIf
      ElseIf checkedResult <> doubleExpected
        mismatchChecked + 1
        If mismatchChecked <= 5
          PrintN("    FixedDiv2Checked result mismatch: a=" + Str(a) +
                 " b=" + Str(b) + " actual=" + Str(checkedResult) +
                 " double-trunc=" + Str(doubleExpected))
        EndIf
      EndIf
    Else
      If doubleFailure = 0
        mismatchChecked + 1
        If mismatchChecked <= 5
          PrintN("    FixedDiv2Checked predicate mismatch: a=" + Str(a) +
                 " b=" + Str(b) + " checked=False referenceFailure=0")
        EndIf
      EndIf
    EndIf

    If Bool(oracleComputed) = #False
      mismatchChecked + 1
    EndIf
  Next

  Check(Bool(mismatchFixed = 0),
        "10,000 FixedDiv inputs (seed 0x12345678 plus boundary vectors) match guarded oracle")
  Check(Bool(mismatchChecked = 0),
        "same inputs match the active FixedDiv2 double predicate and truncation")
  Check(Bool(FixedLastError() = ""),
        "differential loop finishes with a cleared checked-helper error")
EndProcedure

Procedure TestFM38NegativeArithmeticShift()
  BeginCase("FM38", "Signed arithmetic shift floors negative values")
  Protected product.q

  product = -1
  Check(Bool((product >> #FRACBITS) = -1), "Quad arithmetic shift: -1 >>16 = -1")
  product = -65536
  Check(Bool((product >> #FRACBITS) = -1), "-65536 >>16 = -1 (exact)")
  product = -65537
  Check(Bool((product >> #FRACBITS) = -2), "-65537 >>16 = -2 (floor, not truncation)")
  product = -131072
  Check(Bool((product >> #FRACBITS) = -2), "-131072 >>16 = -2")
  product = -131073
  Check(Bool((product >> #FRACBITS) = -3), "-131073 >>16 = -3")

  Check(Bool(OracleFloorProduct(-1) = -1), "division/remainder oracle floors -1")
  Check(Bool(OracleFloorProduct(-65537) = -2), "division/remainder oracle floors -65537")
  Check(Bool(OracleFloorProduct(-131073) = -3), "division/remainder oracle floors -131073")
  CheckMulVsOracle(1, -1)
  CheckMulVsOracle(-1, 1)
  CheckMulVsOracle(-1, -65536)
  CheckMulVsOracle(65536, -1)
  CheckMulVsOracle(-32768, 32768)
  CheckMulVsOracle(12345, -67890)
EndProcedure

Procedure TestFM39SignedNarrowing()
  BeginCase("FM39", "Explicit low-32 two's-complement wrap across signs")
  Check(Bool(FixedMul(#FIXED_MAX, #FIXED_MAX) = -65536),
        "positive overflow floor 70368744112128 wraps to FFFF0000 = -65536")
  Check(Bool(FixedMul(#FIXED_MIN, #FIXED_MIN) = 0),
        "negative overflow floor 70368744177664 wraps to 00000000 = 0")
  Check(Bool(FixedMul(#FIXED_MAX, 65537) = -2147450882),
        "max*65537 positive floor wraps across sign to -2147450882")
  Check(Bool(SignedBitHex(FixedMul(#FIXED_MAX, 65537)) = "80007FFE"),
        "max*65537 exact low32 bits 80007FFE")
  Check(Bool(FixedMul(#FIXED_MIN, 65537) = 2147450880),
        "min*65537 negative floor wraps across sign to positive 2147450880")
  Check(Bool(SignedBitHex(FixedMul(#FIXED_MIN, 65537)) = "7FFF8000"),
        "min*65537 exact low32 bits 7FFF8000")
  CheckMulVsOracle(12345, -98765)
EndProcedure

Procedure TestFM40Repeatability()
  BeginCase("FM40", "Repeatability and checked-error clearing")
  Protected value.l = 77
  Protected first.l
  Protected second.l

  Check(Bool(FixedDiv2Checked(32768, 1, @value) = #False), "checked overflow fails first")
  Check(Bool(value = 77), "failure leaves result intact")
  Check(Bool(FindString(FixedLastError(), "outside") > 0), "failure diagnostic is set")

  value = 77
  Check(Bool(FixedDiv2Checked(-32768, 1, @value) = #True), "following valid call succeeds")
  Check(Bool(value = #FIXED_MIN), "valid result is exact signed32 minimum")
  Check(Bool(FixedLastError() = ""), "success clears the previous error")

  value = 77
  Check(Bool(FixedDiv2Checked(-32768, 1, @value) = #True), "repeated valid call succeeds")
  Check(Bool(value = #FIXED_MIN), "repeated result is identical")
  Check(Bool(FixedLastError() = ""), "repeated success leaves cleared state")

  value = 77
  Check(Bool(FixedFromIntChecked(32768, @value) = #False), "conversion overflow fails")
  Check(Bool(value = 77), "conversion failure leaves result intact")
  value = 0
  Check(Bool(FixedFromIntChecked(-32768, @value) = #True), "following valid conversion succeeds")
  Check(Bool(value = #FIXED_MIN), "conversion success writes signed32 minimum")
  Check(Bool(FixedLastError() = ""), "conversion success clears the error")

  first = FixedMul(#FIXED_MAX, #FIXED_MAX)
  second = FixedMul(#FIXED_MAX, #FIXED_MAX)
  Check(Bool(first = second), "repeated FixedMul gives identical wrapped value")
  first = FixedDiv(16383, 1)
  second = FixedDiv(16383, 1)
  Check(Bool(first = second), "repeated FixedDiv gives identical guarded value")
  first = FixedDiv(123, 0)
  second = FixedDiv(123, 0)
  Check(Bool(first = second), "repeated zero-divisor saturation is deterministic")

  Check(Bool(FixedDiv2Checked(1, 2, 0) = #False), "null checked result pointer is rejected")
  Check(Bool(FindString(FixedLastError(), "pointer is null") > 0), "null result pointer diagnostic")
  Check(Bool(FixedFromIntChecked(1, 0) = #False), "null conversion result pointer is rejected")
EndProcedure

; ---------------------------------------------------------------------------
; Integration scenarios FI01-FI03
; ---------------------------------------------------------------------------

Procedure TestFI01StandaloneInclusion()
  BeginCase("FI01", "Standalone module inclusion without WAD/display/map")
  Check(Bool(#DOOMPB_FIXED_PBI = 1), "Fixed module inclusion guard was defined")
  Check(Bool(FixedMul(#FRACUNIT, 32768) = 32768), "standalone value operation works")
  Check(Bool(FixedDiv(65536, 32768) = 131072), "standalone division works")
  Check(Bool(FixedToIntFloor(-65537) = -2), "standalone shift helper works")
  Protected converted.l = 0
  Check(Bool(FixedFromIntChecked(32767, @converted)), "standalone conversion works")
  Check(Bool(converted = 2147418112), "standalone conversion result is exact")
EndProcedure

Procedure TestFI02SyntheticMapBridge()
  BeginCase("FI02", "Synthetic signed map coordinate/height bridge")
  Protected vertexX.q = -32768
  Protected vertexY.q = 32767
  Protected sectorFloor.q = -32768
  Protected sectorCeiling.q = 32767
  Protected textureOffset.q = -1
  Protected rowOffset.q = 1
  Protected result.l = 0

  Check(Bool(FixedFromIntChecked(vertexX, @result)), "vertex X=-32768 is representable")
  Check(Bool(result = -2147483648), "vertex X fixed bits are exactly -2147483648")
  result = 0
  Check(Bool(FixedFromIntChecked(vertexY, @result)), "vertex Y=+32767 is representable")
  Check(Bool(result = 2147418112), "vertex Y fixed bits are exactly 2147418112")
  result = 0
  Check(Bool(FixedFromIntChecked(sectorFloor, @result)), "sector floor=-32768 is representable")
  Check(Bool(result = -2147483648), "floor height fixed bits are exactly -2147483648")
  result = 0
  Check(Bool(FixedFromIntChecked(sectorCeiling, @result)), "sector ceiling=+32767 is representable")
  Check(Bool(result = 2147418112), "ceiling height fixed bits are exactly 2147418112")
  result = 0
  Check(Bool(FixedFromIntChecked(textureOffset, @result)), "sidedef texture offset=-1 is representable")
  Check(Bool(result = -65536), "texture offset fixed bits are exactly -65536")
  result = 0
  Check(Bool(FixedFromIntChecked(rowOffset, @result)), "sidedef row offset=+1 is representable")
  Check(Bool(result = 65536), "row offset fixed bits are exactly 65536")

  ; No floating-point path exists in this module; exact integer values above
  ; would expose any rounding. Also verify arithmetic floor round-trips.
  Check(Bool(FixedToIntFloor(2147418112) = 32767), "ceiling fixed value floors back to 32767")
  Check(Bool(FixedToIntFloor(-2147483648) = -32768), "floor fixed value floors back to -32768")
EndProcedure

; Writes the 12-entry deterministic operation sequence into caller memory.
Procedure.i WriteFixedSequence(*Target.Long)
  If *Target = 0
    ProcedureReturn #False
  EndIf

  *Target\l = FixedMul(#FIXED_MAX, #FIXED_MAX)
  *Target + #TEST_LongBytes
  *Target\l = FixedMul(#FIXED_MIN, #FIXED_MIN)
  *Target + #TEST_LongBytes
  *Target\l = FixedMul(32768, -32768)
  *Target + #TEST_LongBytes
  *Target\l = FixedDiv(16383, 1)
  *Target + #TEST_LongBytes
  *Target\l = FixedDiv(16384, 1)
  *Target + #TEST_LongBytes
  *Target\l = FixedDiv(0, 0)
  *Target + #TEST_LongBytes
  *Target\l = FixedDiv(-123, 0)
  *Target + #TEST_LongBytes
  *Target\l = FixedDiv(#FIXED_MIN, #FIXED_MIN)
  *Target + #TEST_LongBytes
  *Target\l = 2147418112
  *Target + #TEST_LongBytes
  *Target\l = FixedToIntFloor(-65537)
  *Target + #TEST_LongBytes
  *Target\l = #FIXED_MIN
  *Target + #TEST_LongBytes
  *Target\l = FixedMul(1, -1)
  *Target + #TEST_LongBytes

  ProcedureReturn #True
EndProcedure

Procedure TestFI03DeterministicRepeat()
  BeginCase("FI03", "Deterministic repeat after an intentional checked-division error")
  Protected *first = 0
  Protected *second = 0
  Protected errorValue.l = 0
  Protected i.i
  Protected firstValue.l
  Protected secondValue.l
  Protected mismatches.i = 0
  Protected written.i

  *first = AllocateMemory(12 * #TEST_LongBytes)
  *second = AllocateMemory(12 * #TEST_LongBytes)
  Check(Bool(*first <> 0), "first sequence buffer allocated")
  Check(Bool(*second <> 0), "second sequence buffer allocated")
  If *first = 0 Or *second = 0
    If *first <> 0
      FreeMemory(*first)
    EndIf
    If *second <> 0
      FreeMemory(*second)
    EndIf
    ProcedureReturn
  EndIf

  Check(Bool(FixedDiv2Checked(32768, 1, @errorValue) = #False),
        "intentional checked-division overflow error raised before repeat")
  Check(Bool(errorValue = 0), "intentional failure leaves its output untouched")

  written = WriteFixedSequence(*first)
  Check(Bool(written = #True), "first 12-operation sequence written")

  ; Repeat the same intentional error to prove failure state does not leak.
  Check(Bool(FixedDiv2Checked(#FIXED_MIN, 1, @errorValue) = #False),
        "second intentional checked error raised between runs")

  written = WriteFixedSequence(*second)
  Check(Bool(written = #True), "second 12-operation sequence written")

  For i = 0 To 11
    firstValue = PeekL(*first + i * #TEST_LongBytes)
    secondValue = PeekL(*second + i * #TEST_LongBytes)
    If firstValue <> secondValue
      mismatches + 1
    EndIf
    Check(Bool(firstValue = secondValue),
          "sequence[" + Str(i + 1) + "] repeated identically: " +
          Str(firstValue))
  Next

  Check(Bool(mismatches = 0), "all 12 explicit results repeated identically")
  Check(Bool(FixedDiv2Checked(-32768, 1, @errorValue) = #True),
        "a valid checked call after the repeat still succeeds")
  Check(Bool(errorValue = #FIXED_MIN), "that post-repeat result is exact")
  Check(Bool(FixedLastError() = ""), "post-repeat success clears the error state")

  FreeMemory(*first)
  FreeMemory(*second)
EndProcedure

